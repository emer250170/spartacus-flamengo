<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="seatHoldService" class="br.com.flamengo.matchday.service.impl.DefaultSeatHoldService">
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="stockService" ref="stockService"/>
		<property name="userService" ref="userService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="commerceCartService" ref="commerceCartService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
		<property name="baseSiteService" ref="baseSiteService"/>
	</bean>

	<!--
		Reserva apagada fora do servico (ex.: pelo administrador no Backoffice):
		a poltrona volta a venda e sai do carrinho do torcedor.
	-->
	<bean id="seatHoldRemoveInterceptor" class="br.com.flamengo.matchday.interceptor.SeatHoldRemoveInterceptor">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>
	<bean id="seatHoldRemoveInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="seatHoldRemoveInterceptor"/>
		<property name="typeCode" value="SeatHold"/>
	</bean>

	<!-- Adicionar ao carrinho: reserva a poltrona -->
	<bean id="seatHoldAddToCartMethodHook" class="br.com.flamengo.matchday.hook.SeatHoldAddToCartMethodHook">
		<property name="seatHoldService" ref="seatHoldService"/>
		<property name="userService" ref="userService"/>
		<property name="modelService" ref="modelService"/>
		<property name="commerceCartCalculationStrategy" ref="commerceCartCalculationStrategy"/>
	</bean>
	<bean id="seatHoldAddToCartMethodHookMergeDirective" depends-on="commerceAddToCartMethodHooks" parent="listMergeDirective">
		<property name="add" ref="seatHoldAddToCartMethodHook"/>
	</bean>

	<!-- Tirar do carrinho: libera a poltrona -->
	<bean id="seatHoldUpdateCartEntryHook" class="br.com.flamengo.matchday.hook.SeatHoldUpdateCartEntryHook">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>
	<bean id="seatHoldUpdateCartEntryHookMergeDirective" depends-on="commerceUpdateCartEntryMethodHooks" parent="listMergeDirective">
		<property name="add" ref="seatHoldUpdateCartEntryHook"/>
	</bean>

	<!-- Fechar o pedido: confere a reserva e converte em venda -->
	<bean id="seatHoldPlaceOrderMethodHook" class="br.com.flamengo.matchday.hook.SeatHoldPlaceOrderMethodHook">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>
	<bean id="seatHoldPlaceOrderMethodHookMergeDirective" depends-on="commercePlaceOrderMethodHooks" parent="listMergeDirective">
		<property name="add" ref="seatHoldPlaceOrderMethodHook"/>
	</bean>

	<!--
		Validação do carrinho: a poltrona reservada pelo próprio carrinho conta
		como disponível (para os outros ela está esgotada).
	-->
	<alias name="seatHoldCartValidationStrategy" alias="cartValidationStrategy"/>
	<bean id="seatHoldCartValidationStrategy" parent="defaultB2BCartValidationStrategy"
		  class="br.com.flamengo.matchday.strategy.SeatHoldCartValidationStrategy">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>

	<!--
		A API de comércio (OCC, usada pela loja Spartacus) valida o carrinho com
		outro serviço, commerceWebServicesCartService, que o commerceservices liga
		direto na defaultCartValidationStrategy (sem passar pelo alias acima). Sem
		isto, ao fechar o pedido na loja a poltrona reservada pelo próprio
		carrinho aparecia como "sem estoque" e saía do carrinho.
	-->
	<alias name="seatHoldCommerceWebServicesCartService" alias="commerceWebServicesCartService"/>
	<bean id="seatHoldCommerceWebServicesCartService" parent="defaultCommerceWebServicesCartService">
		<property name="cartValidationStrategy" ref="cartValidationStrategy"/>
	</bean>

	<!--
		Sócio-torcedor: plano Nação Maraca no carrinho já vale como sócio (grupo do
		plano + marcador nacao-pendente-N); se o plano sai, os grupos saem e os
		ingressos fora da onda do torcedor saem do carrinho.
	-->
	<bean id="socioCartService" class="br.com.flamengo.matchday.socio.SocioCartService">
		<property name="userService" ref="userService"/>
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="seatHoldService" ref="seatHoldService"/>
		<property name="commerceCartCalculationStrategy" ref="commerceCartCalculationStrategy"/>
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="socioGuestService" ref="socioGuestService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="baseSiteService" ref="baseSiteService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
	</bean>
	<bean id="socioCartHooks" class="br.com.flamengo.matchday.socio.SocioCartHooks">
		<property name="socioCartService" ref="socioCartService"/>
	</bean>
	<bean id="socioAddToCartMethodHookMergeDirective" depends-on="commerceAddToCartMethodHooks" parent="listMergeDirective">
		<property name="add" ref="socioCartHooks"/>
	</bean>
	<bean id="socioUpdateCartEntryHookMergeDirective" depends-on="commerceUpdateCartEntryMethodHooks" parent="listMergeDirective">
		<property name="add" ref="socioCartHooks"/>
	</bean>

	<!-- Jogos: tela "Jogos" do Backoffice -->
	<!-- Imagem dos jogos e das experiências copiada para o produto da loja (04/11) -->
	<bean id="flamengoProductImageService" class="br.com.flamengo.matchday.media.impl.DefaultProductImageService">
		<property name="configurationService" ref="configurationService"/>
		<property name="mediaService" ref="mediaService"/>
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
	</bean>

	<bean id="matchdayGameService" class="br.com.flamengo.matchday.game.impl.DefaultMatchdayGameService">
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="catalogVersionService" ref="catalogVersionService"/>
		<property name="importService" ref="importService"/>
		<property name="mediaService" ref="mediaService"/>
		<property name="cronJobService" ref="cronJobService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="productImageService" ref="flamengoProductImageService"/>
	</bean>

	<bean id="matchdayGameInterceptor" class="br.com.flamengo.matchday.interceptor.MatchdayGameInterceptor">
		<property name="matchdayGameService" ref="matchdayGameService"/>
	</bean>
	<bean id="matchdayGameInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="matchdayGameInterceptor"/>
		<property name="typeCode" value="MatchdayGame"/>
	</bean>

	<bean id="matchdayGameSeatsTotalHandler" class="br.com.flamengo.matchday.attribute.MatchdayGameSeatsAttributeHandler">
		<property name="matchdayGameService" ref="matchdayGameService"/>
		<property name="mode" value="TOTAL"/>
	</bean>
	<bean id="matchdayGameSeatsAvailableHandler" class="br.com.flamengo.matchday.attribute.MatchdayGameSeatsAttributeHandler">
		<property name="matchdayGameService" ref="matchdayGameService"/>
		<property name="mode" value="AVAILABLE"/>
	</bean>
	<bean id="matchdayGameSeatsSoldHandler" class="br.com.flamengo.matchday.attribute.MatchdayGameSeatsAttributeHandler">
		<property name="matchdayGameService" ref="matchdayGameService"/>
		<property name="mode" value="SOLD"/>
	</bean>

	<!-- Rotina que libera reservas vencidas (CronJob seatHoldExpiryCronJob) -->
	<bean id="seatHoldExpiryJob" class="br.com.flamengo.matchday.job.SeatHoldExpiryJob" parent="abstractJobPerformable">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>

	<!-- Planos de sócio-torcedor (Backoffice > Sócio-Torcedor > Planos) -->
	<bean id="socioPlanService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioPlanService">
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="userService" ref="userService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="catalogVersionService" ref="catalogVersionService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
		<property name="importService" ref="importService"/>
		<property name="mediaService" ref="mediaService"/>
		<property name="cronJobService" ref="cronJobService"/>
		<property name="enumerationService" ref="enumerationService"/>
	</bean>
	<bean id="socioPlanInterceptor" class="br.com.flamengo.matchday.socio.SocioPlanInterceptor">
		<property name="socioPlanService" ref="socioPlanService"/>
	</bean>
	<bean id="socioPlanInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="socioPlanInterceptor"/>
		<property name="typeCode" value="SocioPlan"/>
	</bean>
	<!-- Cancelamento: atendimento fecha o chamado "Cancelamento do plano ..." e o torcedor deixa de ser sócio -->
	<bean id="socioCancelTicketInterceptor" class="br.com.flamengo.matchday.socio.SocioCancelTicketInterceptor">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="socioGuestService" ref="socioGuestService"/>
		<property name="socioExitService" ref="socioExitService"/>
	</bean>
	<bean id="socioCancelTicketInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="socioCancelTicketInterceptor"/>
		<property name="typeCode" value="CsTicket"/>
	</bean>
	<!--
		Linha do tempo do sócio (SocioEvent): Suspensão e Regularização mudam o
		torcedor (grupo socio-suspenso: sem onda de sócio e sem descontos, mantém a vaga).
		Chave liga/desliga: flamengo.socio.suspensao.ativa
	-->
	<bean id="socioEventInterceptor" class="br.com.flamengo.matchday.socio.SocioEventInterceptor">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="socioCartService" ref="socioCartService"/>
		<property name="userService" ref="userService"/>
		<property name="socioContractService" ref="socioContractService"/>
		<property name="socioPaymentService" ref="socioPaymentService"/>
	</bean>
	<bean id="socioEventInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="socioEventInterceptor"/>
		<property name="typeCode" value="SocioEvent"/>
	</bean>
	<!-- Sócio suspenso cadastra cartão novo: a mensalidade em atraso é cobrada nele e os benefícios voltam -->
	<bean id="socioCardRegularizationInterceptor" class="br.com.flamengo.matchday.socio.SocioCardRegularizationInterceptor">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="socioEventInterceptor" ref="socioEventInterceptor"/>
	</bean>
	<bean id="socioCardRegularizationInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="socioCardRegularizationInterceptor"/>
		<property name="typeCode" value="CreditCardPaymentInfo"/>
	</bean>
	<bean id="socioPlanMembersHandler" class="br.com.flamengo.matchday.socio.SocioPlanMembersAttributeHandler">
		<property name="socioPlanService" ref="socioPlanService"/>
	</bean>

	<!-- Atendimento do sócio (Backoffice > Sócio-Torcedor > Sócios): busca, ficha e ações -->
	<bean id="socioMemberService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioMemberService">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="userService" ref="userService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="enumerationService" ref="enumerationService"/>
		<property name="socioEligibilityService" ref="socioEligibilityService"/>
		<property name="socioGuestService" ref="socioGuestService"/>
		<property name="socioTermService" ref="socioTermService"/>
		<property name="socioExitService" ref="socioExitService"/>
		<property name="socioContractService" ref="socioContractService"/>
		<property name="socioPaymentService" ref="socioPaymentService"/>
		<property name="socioPointsService" ref="socioPointsService"/>
	</bean>

	<!--
		Vigência do sócio (item 6): contrato de 12 meses com renovação automática;
		o sócio desliga a renovação ou agenda um plano menor até o prazo; virada no
		Backoffice ou pelo Claude (evento Renovação). Endpoints na API de comércio
		(sociocontract). Chave: flamengo.socio.vigencia.ativo.
	-->
	<bean id="socioContractService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioContractService">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="socioGuestService" ref="socioGuestService"/>
		<property name="socioCartService" ref="socioCartService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
	</bean>

	<!--
		Pix e boleto à vista e plano aguardando pagamento (item 7): com plano no carrinho,
		cartão com a mensalidade, cartão com o ano inteiro em até 12x, Pix ou boleto com o
		ano inteiro. Pix/boleto fecham o pedido sem cartão (sociopayment na API de comércio)
		e o torcedor só vira sócio quando o gestor confirma (evento PAGAMENTO_CONFIRMADO).
		Chave: flamengo.socio.pagamento.ativo.
	-->
	<bean id="socioPaymentService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioPaymentService">
		<property name="configurationService" ref="configurationService"/>
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="commerceCartCalculationStrategy" ref="commerceCartCalculationStrategy"/>
		<property name="commerceCheckoutService" ref="commerceCheckoutService"/>
		<property name="cartService" ref="cartService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="matchdayTicketService" ref="matchdayTicketService"/>
	</bean>
	<!--
		Pagamento pela Adyen (05/11): API de Checkout (sessões), fechamento do pedido e webhook.
		Chave flamengo.pagamento.adyen.ativo (false = pagamento simulado). Conta e chaves na loja base.
	-->
	<bean id="adyenClient" class="br.com.flamengo.matchday.payment.adyen.AdyenClient"/>
	<bean id="adyenPaymentService" class="br.com.flamengo.matchday.payment.adyen.impl.DefaultAdyenPaymentService">
		<property name="configurationService" ref="configurationService"/>
		<property name="baseStoreService" ref="baseStoreService"/>
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="commerceCheckoutService" ref="commerceCheckoutService"/>
		<property name="commerceCartCalculationStrategy" ref="commerceCartCalculationStrategy"/>
		<property name="cartService" ref="cartService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="userService" ref="userService"/>
		<property name="socioPaymentService" ref="socioPaymentService"/>
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="businessProcessService" ref="businessProcessService"/>
		<property name="adyenClient" ref="adyenClient"/>
	</bean>
	<!-- Item 14: mudar o status do pedido para "Pagamento confirmado" confirma o Pix ou boleto -->
	<bean id="orderPaymentStatusInterceptor" class="br.com.flamengo.matchday.interceptor.OrderPaymentStatusInterceptor">
		<property name="modelService" ref="modelService"/>
		<property name="socioPaymentService" ref="socioPaymentService"/>
	</bean>
	<bean id="orderPaymentStatusInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="orderPaymentStatusInterceptor"/>
		<property name="typeCode" value="Order"/>
	</bean>
	<!-- Item 14: estorno no cancelamento. Envolve os adaptadores de pagamento do cancelamento do SAP
	     (orderCancelPaymentServiceAdapter e OmsOrderCancelPaymentServiceAdapter): depois do recálculo
	     padrão, lança o Estorno da diferença entre o capturado e o novo total. Chave
	     flamengo.loja.operacao.ativo (false = só o recálculo padrão). -->
	<bean id="flamengoCancelRefundAdapterPostProcessor" class="br.com.flamengo.matchday.payment.CancelRefundAdapterPostProcessor"/>
	<!-- Item 14: pedido Concluído com remessa de entrega em casa enviada aparece "Enviado" na loja
	     (statusDisplay "shipped"); o resto segue o mapa padrão do acceleratorservices -->
	<bean id="flamengoOrderStatusDisplayHandler" class="br.com.flamengo.matchday.attribute.ShippedOrderStatusDisplayHandler">
		<property name="delegate" ref="acceleratorDynamicAttributesOrderStatusDisplayByMap"/>
		<property name="socioPaymentService" ref="socioPaymentService"/>
	</bean>
	<alias name="flamengoOrderStatusDisplayHandler" alias="dynamicAttributesOrderStatusDisplay"/>
	<!-- Ano inteiro: preço do plano e dos convidados x12 no calculationService (só com a forma gravada) -->
	<bean id="socioAnnualPricing" class="br.com.flamengo.matchday.socio.SocioAnnualPricing">
		<property name="calculationService" ref="calculationService"/>
		<property name="socioPaymentService" ref="socioPaymentService"/>
	</bean>
	<!-- Checagem de fraude: limite de valor do pedido (flamengo.fraude.limitePedido; vazio = padrão do Commerce) -->
	<bean id="socioFraudThreshold" class="br.com.flamengo.matchday.socio.SocioFraudThreshold">
		<property name="fraudService" ref="fraudService"/>
		<property name="configurationService" ref="configurationService"/>
	</bean>
	<bean id="socioPaymentPlaceOrderMethodHook" class="br.com.flamengo.matchday.hook.SocioPaymentPlaceOrderMethodHook">
		<property name="socioPaymentService" ref="socioPaymentService"/>
	</bean>
	<bean id="socioPaymentPlaceOrderMethodHookMergeDirective" depends-on="commercePlaceOrderMethodHooks" parent="listMergeDirective">
		<property name="add" ref="socioPaymentPlaceOrderMethodHook"/>
	</bean>

	<!--
		Regras de saída do sócio (item 5): reembolso no prazo de arrependimento, multa
		sobre as mensalidades restantes fora dele. Simulação na loja (socioexit) e na
		ficha; valores gravados no evento de cancelamento. Chave: flamengo.socio.saida.ativo.
	-->
	<bean id="socioExitService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioExitService">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="socioContractService" ref="socioContractService"/>
	</bean>

	<!--
		Convidados nominais do sócio (item 3): o titular dá nome às vagas de convidado
		contratadas no plano. Endpoints na API de comércio em
		resources/occ/v2/flamengomatchdayocc/web/spring/flamengomatchday-web-spring.xml.
		Chave: flamengo.socio.convidados.ativo (true).
	-->
	<bean id="socioGuestService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioGuestService">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>
	<!--
		Ingresso do convidado: ao fechar o pedido do sócio, cada poltrona além da dele
		precisa de convidado (chave flamengo.socio.convidados.ingressoNominal)
	-->
	<!--
		Ingresso adicional de quem não é sócio (04/11): nome, CPF, nascimento e e-mail de
		quem vai usar; o pedido só fecha com os dados (flamengo.ingressos.portador.obrigatorio).
	-->
	<bean id="ticketHolderService" class="br.com.flamengo.matchday.ticket.impl.DefaultTicketHolderService">
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="seatHoldService" ref="seatHoldService"/>
		<property name="socioPlanService" ref="socioPlanService"/>
	</bean>
	<bean id="socioGuestPlaceOrderMethodHook" class="br.com.flamengo.matchday.hook.SocioGuestPlaceOrderMethodHook">
		<property name="socioGuestService" ref="socioGuestService"/>
		<property name="ticketHolderService" ref="ticketHolderService"/>
	</bean>
	<bean id="socioGuestPlaceOrderMethodHookMergeDirective" depends-on="commercePlaceOrderMethodHooks" parent="listMergeDirective">
		<property name="add" ref="socioGuestPlaceOrderMethodHook"/>
	</bean>

	<!--
		Termo do Nação versionado (item 4): pedido com plano só fecha com o aceite da
		versão atual; o aceite vira evento na linha do tempo. Endpoints na API de
		comércio (socioterm). Chave: flamengo.socio.termo.ativo (true).
	-->
	<bean id="socioTermService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioTermService">
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
		<property name="socioPlanService" ref="socioPlanService"/>
	</bean>
	<bean id="socioTermPlaceOrderMethodHook" class="br.com.flamengo.matchday.hook.SocioTermPlaceOrderMethodHook">
		<property name="socioTermService" ref="socioTermService"/>
	</bean>
	<bean id="socioTermPlaceOrderMethodHookMergeDirective" depends-on="commercePlaceOrderMethodHooks" parent="listMergeDirective">
		<property name="add" ref="socioTermPlaceOrderMethodHook"/>
	</bean>

	<!--
		Elegibilidade para comprar ingresso: confere plano, situação, janela da onda,
		biometria e limite por jogo, e grava cada tentativa (SocioEligibilityDecision).
		Chaves: flamengo.socio.elegibilidade.registro (true), .bloqueio (false = só
		observa), flamengo.socio.biometria.exigida (false), flamengo.ingressos.limite.geral (4).
	-->
	<bean id="socioEligibilityService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioEligibilityService">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="socioCartService" ref="socioCartService"/>
		<property name="seatHoldService" ref="seatHoldService"/>
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="userService" ref="userService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="socioGuestService" ref="socioGuestService"/>
	</bean>
	<bean id="socioEligibilityAddToCartHook" class="br.com.flamengo.matchday.hook.SocioEligibilityAddToCartHook">
		<property name="socioEligibilityService" ref="socioEligibilityService"/>
	</bean>
	<bean id="socioEligibilityAddToCartHookMergeDirective" depends-on="commerceAddToCartMethodHooks" parent="listMergeDirective">
		<property name="add" ref="socioEligibilityAddToCartHook"/>
	</bean>

	<!-- Relatórios do sócio-torcedor (Backoffice > Sócio-Torcedor > Relatórios) -->
	<bean id="socioReportService" class="br.com.flamengo.matchday.report.socio.impl.DefaultSocioReportService">
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="socioExitService" ref="socioExitService"/>
	</bean>

	<!--
		Pontos, experiências e carteirinha (item 8): saldo calculado dos pedidos desde a
		adesão (ingressos e produtos), vitrine de experiências cadastradas no Backoffice e
		resgate com voucher (evento Resgate de pontos). Endpoints na API de comércio
		(sociopoints). Chave: flamengo.socio.pontos.ativo.
	-->
	<bean id="socioPointsService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioPointsService">
		<property name="configurationService" ref="configurationService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="socioPaymentService" ref="socioPaymentService"/>
		<property name="seatHoldService" ref="seatHoldService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="socioExperienceService" ref="socioExperienceService"/>
		<property name="matchdayTicketService" ref="matchdayTicketService"/>
	</bean>

	<!--
		Experiências vendidas na loja (item 9): produto gerado ao salvar a experiência com preço,
		estoque único (vagas) para venda e resgate, voucher também na compra.
		Chave liga/desliga: flamengo.socio.experiencias.venda.ativo
	-->
	<bean id="socioExperienceService" class="br.com.flamengo.matchday.socio.impl.DefaultSocioExperienceService">
		<property name="configurationService" ref="configurationService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="catalogVersionService" ref="catalogVersionService"/>
		<property name="importService" ref="importService"/>
		<property name="mediaService" ref="mediaService"/>
		<property name="cronJobService" ref="cronJobService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="userService" ref="userService"/>
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="productImageService" ref="flamengoProductImageService"/>
	</bean>
	<bean id="socioExperienceInterceptor" class="br.com.flamengo.matchday.socio.SocioExperienceInterceptor">
		<property name="socioExperienceService" ref="socioExperienceService"/>
	</bean>
	<bean id="socioExperienceInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="socioExperienceInterceptor"/>
		<property name="typeCode" value="SocioExperience"/>
	</bean>
	<bean id="socioRedemptionInterceptor" class="br.com.flamengo.matchday.socio.SocioRedemptionInterceptor">
		<property name="socioExperienceService" ref="socioExperienceService"/>
		<property name="socioPlanService" ref="socioPlanService"/>
		<property name="userService" ref="userService"/>
	</bean>
	<bean id="socioRedemptionInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="socioRedemptionInterceptor"/>
		<property name="typeCode" value="SocioRedemption"/>
	</bean>
	<bean id="socioExperiencePlaceOrderMethodHook" class="br.com.flamengo.matchday.hook.SocioExperiencePlaceOrderMethodHook">
		<property name="socioExperienceService" ref="socioExperienceService"/>
	</bean>
	<bean id="socioExperiencePlaceOrderMethodHookMergeDirective" depends-on="commercePlaceOrderMethodHooks" parent="listMergeDirective">
		<property name="add" ref="socioExperiencePlaceOrderMethodHook"/>
	</bean>

	<!--
		Entrega das experiências: carrinho só de experiências com voucher = só o modo digital;
		com experiência enviada pelo correio = só os modos com frete; outros carrinhos não mudam.
		Chave: flamengo.socio.experiencias.entrega.ativo
	-->
	<alias name="flamengoDeliveryModeLookupStrategy" alias="deliveryModeLookupStrategy"/>
	<bean id="flamengoDeliveryModeLookupStrategy" class="br.com.flamengo.matchday.strategy.FlamengoDeliveryModeLookupStrategy"
		parent="defaultDeliveryModeLookupStrategy">
		<property name="configurationService" ref="configurationService"/>
	</bean>

	<!--
		Ingressos vendidos (item 10): uma linha por poltrona vendida, criada ao fechar o pedido,
		com histórico das ações do gestor de jogos (cockpit Matchday > Ingressos e Claude).
		Chave: flamengo.matchday.ingressos.ativo
	-->
	<bean id="matchdayTicketService" class="br.com.flamengo.matchday.ticket.impl.DefaultMatchdayTicketService">
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="seatHoldService" ref="seatHoldService"/>
		<property name="socioGuestService" ref="socioGuestService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="userService" ref="userService"/>
	</bean>
	<bean id="matchdayTicketEventInterceptor" class="br.com.flamengo.matchday.ticket.MatchdayTicketEventInterceptor">
		<property name="matchdayTicketService" ref="matchdayTicketService"/>
	</bean>
	<bean id="matchdayTicketEventInterceptorMapping" class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
		<property name="interceptor" ref="matchdayTicketEventInterceptor"/>
		<property name="typeCode" value="MatchdayTicketEvent"/>
	</bean>
	<bean id="matchdayTicketPlaceOrderMethodHook" class="br.com.flamengo.matchday.hook.MatchdayTicketPlaceOrderMethodHook">
		<property name="matchdayTicketService" ref="matchdayTicketService"/>
	</bean>
	<bean id="matchdayTicketPlaceOrderMethodHookMergeDirective" depends-on="commercePlaceOrderMethodHooks" parent="listMergeDirective">
		<property name="add" ref="matchdayTicketPlaceOrderMethodHook"/>
	</bean>

	<!-- Relatório de ingressos (Backoffice > Matchday Flamengo > Relatórios) -->
	<bean id="matchdayReportService" class="br.com.flamengo.matchday.report.impl.DefaultMatchdayReportService">
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="matchdayGameService" ref="matchdayGameService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
	</bean>

	<!-- Resumo de vendas do painel inicial do administrador (Backoffice > Cockpit de administração > Principal) -->
	<bean id="summaryReportService" class="br.com.flamengo.matchday.report.summary.impl.DefaultSummaryReportService">
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="matchdayReportService" ref="matchdayReportService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
	</bean>

	<!-- Painel inicial do gestor de merchandising (Backoffice > Cockpit de administração) -->
	<bean id="merchDashboardService" class="br.com.flamengo.matchday.report.merch.impl.DefaultMerchDashboardService">
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
		<property name="sessionService" ref="sessionService"/>
		<property name="searchRestrictionService" ref="searchRestrictionService"/>
		<property name="configurationService" ref="configurationService"/>
	</bean>

	<!-- Atendimento do pedido: Pick up / Shipping esperam o processo da consignação ficar pronto
	     (ligado pelo jobHandler dos modelos NPR_Automated_Pickup e NPR_Automated_Shipping,
	     docs/flamengo-matchday/08-atendimento-espera.impex) -->
	<bean id="flaPickupConsignmentActionComEspera" class="br.com.flamengo.matchday.fulfillment.WaitingWorkflowActionJob">
		<property name="delegate" ref="taskAssignmentPickupConsignmentAction"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
	</bean>
	<bean id="flaShipConsignmentActionComEspera" class="br.com.flamengo.matchday.fulfillment.WaitingWorkflowActionJob">
		<property name="delegate" ref="taskAssignmentShipConsignmentAction"/>
		<property name="configurationService" ref="configurationService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="modelService" ref="modelService"/>
	</bean>

</beans>
