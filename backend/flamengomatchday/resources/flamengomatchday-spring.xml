<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="seatHoldService" class="br.com.flamengo.matchday.service.impl.DefaultSeatHoldService">
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="stockService" ref="stockService"/>
		<property name="userService" ref="userService"/>
		<property name="configurationService" ref="configurationService"/>
	</bean>

	<!-- Adicionar ao carrinho: reserva a poltrona -->
	<bean id="seatHoldAddToCartMethodHook" class="br.com.flamengo.matchday.hook.SeatHoldAddToCartMethodHook">
		<property name="seatHoldService" ref="seatHoldService"/>
		<property name="userService" ref="userService"/>
		<property name="modelService" ref="modelService"/>
		<property name="commerceCartCalculationStrategy" ref="commerceCartCalculationStrategy"/>
	</bean>
	<bean id="seatHoldAddToCartMethodHookMergeDirective" depends-on="commerceAddToCartMethodHooks" parent="listMergeDirective">
		<property name="add" ref="seatHoldAddToCartMethodHook"/>
	</bean>

	<!-- Tirar do carrinho: libera a poltrona -->
	<bean id="seatHoldUpdateCartEntryHook" class="br.com.flamengo.matchday.hook.SeatHoldUpdateCartEntryHook">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>
	<bean id="seatHoldUpdateCartEntryHookMergeDirective" depends-on="commerceUpdateCartEntryMethodHooks" parent="listMergeDirective">
		<property name="add" ref="seatHoldUpdateCartEntryHook"/>
	</bean>

	<!-- Fechar o pedido: confere a reserva e converte em venda -->
	<bean id="seatHoldPlaceOrderMethodHook" class="br.com.flamengo.matchday.hook.SeatHoldPlaceOrderMethodHook">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>
	<bean id="seatHoldPlaceOrderMethodHookMergeDirective" depends-on="commercePlaceOrderMethodHooks" parent="listMergeDirective">
		<property name="add" ref="seatHoldPlaceOrderMethodHook"/>
	</bean>

	<!--
		Validação do carrinho: a poltrona reservada pelo próprio carrinho conta
		como disponível (para os outros ela está esgotada).
	-->
	<alias name="seatHoldCartValidationStrategy" alias="cartValidationStrategy"/>
	<bean id="seatHoldCartValidationStrategy" parent="defaultB2BCartValidationStrategy"
		  class="br.com.flamengo.matchday.strategy.SeatHoldCartValidationStrategy">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>

	<!-- Rotina que libera reservas vencidas (CronJob seatHoldExpiryCronJob) -->
	<bean id="seatHoldExpiryJob" class="br.com.flamengo.matchday.job.SeatHoldExpiryJob" parent="abstractJobPerformable">
		<property name="seatHoldService" ref="seatHoldService"/>
	</bean>

</beans>
