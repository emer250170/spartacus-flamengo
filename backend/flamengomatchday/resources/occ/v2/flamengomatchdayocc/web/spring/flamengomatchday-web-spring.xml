<?xml version="1.0" encoding="UTF-8"?>
<!--
	Endpoints próprios da demo na API de comércio (OCC v2). A commercewebservices
	importa todo classpath*:/occ/v2/*occ/web/spring/*-web-spring.xml no contexto web
	dela; por isso a pasta termina em "occ". Os serviços vêm do contexto da
	extensão (flamengomatchday-spring.xml).
-->
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- Criar conta com CPF (07/11): POST /{baseSiteId}/users?cpf=... confere o CPF antes de criar a conta.
	     MappedInterceptor: o handler mapping da commercewebservices pega sozinho os desta configuração. -->
	<bean id="flamengoSignupCpfInterceptor" class="org.springframework.web.servlet.handler.MappedInterceptor">
		<constructor-arg index="0" type="java.lang.String[]">
			<array value-type="java.lang.String">
				<value>/**</value>
			</array>
		</constructor-arg>
		<constructor-arg index="1" type="org.springframework.web.servlet.HandlerInterceptor">
			<bean class="br.com.flamengo.matchday.occ.SignupCpfInterceptor">
				<property name="flexibleSearchService" ref="flexibleSearchService"/>
				<property name="configurationService" ref="configurationService"/>
			</bean>
		</constructor-arg>
	</bean>

	<!-- Meus convidados: /{baseSiteId}/users/{userId}/socioguests -->
	<bean id="flamengoSocioGuestsController" class="br.com.flamengo.matchday.occ.SocioGuestsController">
		<property name="socioGuestService" ref="socioGuestService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Termo do Nação: /{baseSiteId}/users/{userId}/socioterm -->
	<bean id="flamengoSocioTermController" class="br.com.flamengo.matchday.occ.SocioTermController">
		<property name="socioTermService" ref="socioTermService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Regras de saída do sócio (item 5): GET /users/current/socioexit -->
	<bean id="flamengoSocioExitController" class="br.com.flamengo.matchday.occ.SocioExitController">
		<property name="socioExitService" ref="socioExitService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Vigência do sócio (item 6): /users/current/sociocontract (+ /autorenew, /nextplan) -->
	<bean id="flamengoSocioContractController" class="br.com.flamengo.matchday.occ.SocioContractController">
		<property name="socioContractService" ref="socioContractService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Pix e boleto (item 7): /users/current/carts/{cartId}/sociopayment (+ /order) e /orders/{code}/sociopayment -->
	<bean id="flamengoSocioPaymentController" class="br.com.flamengo.matchday.occ.SocioPaymentController">
		<property name="socioPaymentService" ref="socioPaymentService"/>
		<property name="userService" ref="userService"/>
		<property name="cartService" ref="cartService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<!-- Pix e boleto pela Adyen (05/11), conforme flamengo.pagamento.adyen.meios -->
		<property name="adyenPaymentService" ref="adyenPaymentService"/>
		<!-- CPF do cadastro no Pix/boleto (07/11) -->
		<property name="modelService" ref="modelService"/>
	</bean>

	<!-- Pontos e experiências (item 8): /users/current/sociopoints (+ /redemptions) -->
	<bean id="flamengoSocioPointsController" class="br.com.flamengo.matchday.occ.SocioPointsController">
		<property name="socioPointsService" ref="socioPointsService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Quem vai usar cada ingresso adicional de quem não é sócio: /users/current/ticketholders -->
	<bean id="flamengoTicketHoldersController" class="br.com.flamengo.matchday.occ.TicketHoldersController">
		<property name="ticketHolderService" ref="ticketHolderService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Pagamento pela Adyen (05/11): /users/current/adyen/config, /carts/{cartId}/adyen/sessions e /order,
	     /orders/{code}/adyen e o webhook /{baseSiteId}/adyen/notifications -->
	<bean id="flamengoAdyenController" class="br.com.flamengo.matchday.occ.AdyenController">
		<property name="mengoEstudioOrderService" ref="mengoEstudioOrderService"/>
		<property name="adyenPaymentService" ref="adyenPaymentService"/>
		<property name="userService" ref="userService"/>
		<property name="cartService" ref="cartService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
	</bean>

	<!-- Personalização do manto (06/11): /flapersonalization/options e /users/current/carts/{cartId}/flapersonalization
	     (+ /orders/{code}/flapersonalization) -->
	<bean id="flamengoPersonalizationController" class="br.com.flamengo.matchday.occ.PersonalizationController">
		<property name="personalizationService" ref="personalizationService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- "Calcule o frete" da página do produto (06/11): /fladelivery/quote?postalCode=... -->
	<bean id="flamengoDeliveryQuoteController" class="br.com.flamengo.matchday.occ.DeliveryQuoteController">
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
		<property name="baseStoreService" ref="baseStoreService"/>
		<property name="commonI18NService" ref="commonI18NService"/>
		<property name="configurationService" ref="configurationService"/>
	</bean>

	<bean id="flamengoEmarsysCatalogController" class="br.com.flamengo.matchday.occ.EmarsysCatalogController">
		<property name="emarsysCatalogService" ref="flamengoEmarsysCatalogService"/>
		<property name="configurationService" ref="configurationService"/>
	</bean>

	<!-- ClearSale (07/11): configuração para o checkout (script de identificação do aparelho) -->
	<bean id="flamengoClearSaleController" class="br.com.flamengo.matchday.occ.ClearSaleController">
		<property name="clearSaleService" ref="clearSaleService"/>
	</bean>
	<!-- CPF e telefone das contas antigas, informados uma vez no checkout (07/11) -->
	<bean id="flamengoCustomerDataController" class="br.com.flamengo.matchday.occ.CustomerDataController">
		<property name="userService" ref="userService"/>
		<property name="modelService" ref="modelService"/>
		<property name="flexibleSearchService" ref="flexibleSearchService"/>
	</bean>

	<!-- Mengo Estúdio (07/11): /mengo-estudio/catalogo e /mengo-estudio/estampas/{code} (leitura pública) -->
	<bean id="flamengoMengoEstudioController" class="br.com.flamengo.matchday.occ.MengoEstudioController">
		<property name="mengoEstudioService" ref="mengoEstudioService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Mengo Estúdio no carrinho (08/11, PR 3): /users/{userId}/carts/{cartId}/mengo-estudio -->
	<bean id="flamengoMengoEstudioCartController" class="br.com.flamengo.matchday.occ.MengoEstudioCartController">
		<property name="mengoEstudioService" ref="mengoEstudioService"/>
		<property name="mengoEstudioCartService" ref="mengoEstudioCartService"/>
		<property name="userService" ref="userService"/>
	</bean>

	<!-- Mengo Estúdio nos pedidos (08/11, PR 4): /users/{userId}/mengo-estudio/pedidos e
	     /users/{userId}/orders/{code}/mengo-estudio (+ /cancelamento) -->
	<bean id="flamengoMengoEstudioOrderController" class="br.com.flamengo.matchday.occ.MengoEstudioOrderController">
		<property name="mengoEstudioService" ref="mengoEstudioService"/>
		<property name="mengoEstudioOrderService" ref="mengoEstudioOrderService"/>
		<property name="userService" ref="userService"/>
	</bean>

</beans>
