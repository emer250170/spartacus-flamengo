<?xml version="1.0" encoding="UTF-8"?>
<items xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="items.xsd">

	<enumtypes>
		<enumtype code="MatchdayGameStatus" autocreate="true" generate="true" dynamic="false">
			<description>Situação do jogo na loja</description>
			<value code="DRAFT"/>
			<value code="ON_SALE"/>
			<value code="CLOSED"/>
		</enumtype>
		<enumtype code="SocioPlanStatus" autocreate="true" generate="true" dynamic="false">
			<description>Situação do plano de sócio-torcedor na loja</description>
			<value code="DRAFT"/>
			<value code="ON_SALE"/>
			<value code="OFF_SALE"/>
		</enumtype>
		<enumtype code="SocioEventType" autocreate="true" generate="true" dynamic="false">
			<description>Tipo de evento na linha do tempo do sócio-torcedor</description>
			<value code="ADESAO"/>
			<value code="SUSPENSAO"/>
			<value code="REGULARIZACAO"/>
			<value code="CANCELAMENTO"/>
			<value code="OBSERVACAO"/>
			<value code="ACEITE_TERMO"/>
			<!-- Vigência (item 6): virada com renovação e fim sem renovação -->
			<value code="RENOVACAO"/>
			<value code="FIM_VIGENCIA"/>
			<!-- Pix e boleto (item 7): pedido aguardando pagamento e a confirmação -->
			<value code="AGUARDANDO_PAGAMENTO"/>
			<value code="PAGAMENTO_CONFIRMADO"/>
			<!-- Pontos (item 8): resgate de experiência com pontos -->
			<value code="RESGATE_PONTOS"/>
			<!-- Experiências na loja (item 9): compra, voucher usado na portaria, resgate cancelado -->
			<value code="COMPRA_EXPERIENCIA"/>
			<value code="VOUCHER_UTILIZADO"/>
			<value code="RESGATE_CANCELADO"/>
		</enumtype>
		<enumtype code="SocioPaymentMethod" autocreate="true" generate="true" dynamic="false">
			<description>Forma de pagamento do plano de sócio-torcedor no checkout (item 7)</description>
			<value code="CARTAO_MENSAL"/>
			<value code="CARTAO_ANUAL"/>
			<value code="PIX"/>
			<value code="BOLETO"/>
		</enumtype>
		<!-- Ingressos vendidos (item 10) -->
		<enumtype code="MatchdayTicketStatus" autocreate="true" generate="true" dynamic="false">
			<description>Situação do ingresso vendido</description>
			<value code="VALIDO"/>
			<value code="CANCELADO"/>
			<value code="UTILIZADO"/>
		</enumtype>
		<enumtype code="MatchdayTicketEventType" autocreate="true" generate="true" dynamic="false">
			<description>Evento no histórico do ingresso</description>
			<value code="VENDA"/>
			<value code="TROCA_POLTRONA"/>
			<value code="TROCA_TITULAR"/>
			<value code="CANCELAMENTO"/>
			<value code="UTILIZACAO"/>
			<value code="OBSERVACAO"/>
		</enumtype>
	</enumtypes>

	<itemtypes>

		<!--
			Jogo em casa cadastrado pelo time de negócio na tela "Jogos" do
			Backoffice. Ao ficar "À venda", copia o template do Maracanã para o
			produto do jogo (uma variante por poltrona, com preço e estoque);
			ao ficar "Encerrado", tira o jogo da loja e apaga as poltronas não vendidas.
		-->
		<itemtype code="MatchdayGame" extends="GenericItem" autocreate="true" generate="true">
			<description>Jogo em casa (matchday)</description>
			<deployment table="matchdaygames" typecode="25902"/>
			<attributes>
				<attribute qualifier="code" type="java.lang.String">
					<description>JOGO-aaaammdd-ADV, gerado a partir da data e do adversário</description>
					<modifiers unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="opponent" type="java.lang.String">
					<description>Adversário</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="kickoff" type="java.util.Date">
					<description>Data e hora da partida</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="competition" type="java.lang.String">
					<description>Competição e rodada</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="venue" type="java.lang.String">
					<description>Estádio</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="presale" type="java.lang.Boolean">
					<description>Pré-venda para sócios</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="priceNorte" type="java.lang.Double">
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="priceSul" type="java.lang.Double">
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="priceLeste" type="java.lang.Double">
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="priceOeste" type="java.lang.Double">
					<persistence type="property"/>
				</attribute>
				<!--
					Ondas de venda (demo): onda 1 = Nação Maraca 1, onda 2 = Maraca 2,
					onda 3 = Maraca 3, venda geral = todo mundo. Cada onda vale até
					o jogo; quem tem prioridade maior continua podendo comprar.
				-->
				<attribute qualifier="wave1Start" type="java.util.Date">
					<description>Abertura da onda 1 (Nação Maraca 1)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="wave2Start" type="java.util.Date">
					<description>Abertura da onda 2 (Nação Maraca 2)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="wave3Start" type="java.util.Date">
					<description>Abertura da onda 3 (Nação Maraca 3)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="generalSaleStart" type="java.util.Date">
					<description>Abertura da venda geral (quem não é sócio)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="simulatedSoldPercent" type="java.lang.Integer">
					<description>Demonstração: % de poltronas que já abrem vendidas</description>
					<persistence type="property"/>
				</attribute>
				<!-- Imagem da vitrine (04/11): uma foto horizontal (ex.: 1200x675); copiada para o produto do jogo -->
				<attribute qualifier="image" type="Media">
					<description>Imagem do jogo na vitrine (horizontal, ex.: 1200x675)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="status" type="MatchdayGameStatus">
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="product" type="Product">
					<description>Produto do jogo na loja (criado ao colocar à venda)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="statusMessage" type="java.lang.String">
					<description>Resultado da última operação</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="seatsTotal" type="java.lang.Integer">
					<modifiers write="false"/>
					<persistence type="dynamic" attributeHandler="matchdayGameSeatsTotalHandler"/>
				</attribute>
				<attribute qualifier="seatsAvailable" type="java.lang.Integer">
					<modifiers write="false"/>
					<persistence type="dynamic" attributeHandler="matchdayGameSeatsAvailableHandler"/>
				</attribute>
				<attribute qualifier="seatsSold" type="java.lang.Integer">
					<modifiers write="false"/>
					<persistence type="dynamic" attributeHandler="matchdayGameSeatsSoldHandler"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="matchdayGameCode" unique="true">
					<key attribute="code"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Plano de sócio-torcedor cadastrado pelo gestor do programa na perspectiva
			"Sócio-Torcedor" do Backoffice. Ao ficar "À venda", vira o produto de
			assinatura da loja (preço mensal, vagas, convidados, benefícios), o grupo
			de clientes do plano e a promoção de desconto no ingresso; a loja lê as
			regras do plano (onda, desconto, convidados) da descrição do produto.
		-->
		<itemtype code="SocioPlan" extends="GenericItem" autocreate="true" generate="true">
			<description>Plano de sócio-torcedor</description>
			<deployment table="socioplans" typecode="25903"/>
			<attributes>
				<attribute qualifier="code" type="java.lang.String">
					<description>Código do produto do plano (gerado a partir do nome)</description>
					<modifiers unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="name" type="localized:java.lang.String">
					<description>Nome do plano</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="family" type="java.lang.String">
					<description>Programa (Nação Maraca, Nação Sem Fronteiras...)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="summary" type="localized:java.lang.String">
					<description>Resumo que aparece no card do plano</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="benefits" type="localized:java.lang.String">
					<description>Benefícios, um por linha</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="monthlyPrice" type="java.lang.Double">
					<description>Mensalidade (R$)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="ticketDiscount" type="java.lang.Integer">
					<description>Desconto na inteira (%)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="storeDiscount" type="java.lang.Integer">
					<description>Desconto nos produtos da loja (%); não vale para alimentos e bebidas, estacionamento, planos e ingressos</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="wave" type="java.lang.Integer">
					<description>Onda de compra de ingressos: 1, 2 ou 3; 0 = sem prioridade (venda geral)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="maxGuests" type="java.lang.Integer">
					<description>Convidados que o titular pode contratar</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="guestPrice" type="java.lang.Double">
					<description>Mensalidade de cada convidado (R$)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="slots" type="java.lang.Integer">
					<description>Vagas de titulares (em branco = sem limite)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="sortOrder" type="java.lang.Integer">
					<description>Ordem do card na loja</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="status" type="SocioPlanStatus">
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="product" type="Product">
					<description>Produto de assinatura na loja (criado ao colocar à venda)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="customerGroup" type="UserGroup">
					<description>Grupo dos titulares (usado pela promoção de desconto)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="pendingGroup" type="UserGroup">
					<description>Marcador: plano no carrinho, ainda não comprado</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="promotionCode" type="java.lang.String">
					<description>Promoção de desconto no ingresso</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="statusMessage" type="java.lang.String">
					<description>Resultado da última publicação</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="demoBase" type="java.lang.Integer">
					<description>Demonstração: titulares simulados nos relatórios</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="upfrontPayment" type="java.lang.Boolean">
					<description>Aceita o ano inteiro à vista no Pix e no boleto (vazio = sim)</description>
					<defaultvalue>Boolean.TRUE</defaultvalue>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="members" type="java.lang.Integer">
					<description>Titulares ativos na loja (grupo do plano)</description>
					<modifiers write="false"/>
					<persistence type="dynamic" attributeHandler="socioPlanMembersHandler"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioPlanCode" unique="true">
					<key attribute="code"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Reserva temporária de uma poltrona para um carrinho.
			Enquanto existe, a unidade da poltrona fica em StockLevel.reserved,
			então a loja a mostra ocupada para todo mundo.
		-->
		<itemtype code="SeatHold" extends="GenericItem" autocreate="true" generate="true">
			<description>Reserva temporária de poltrona (matchday)</description>
			<deployment table="matchdayseatholds" typecode="25901"/>
			<attributes>
				<attribute qualifier="product" type="Product">
					<description>Poltrona reservada</description>
					<modifiers optional="false" unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="warehouse" type="Warehouse">
					<description>Depósito onde a unidade foi reservada</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cartCode" type="java.lang.String">
					<description>Carrinho que segura a poltrona</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="user" type="User">
					<description>Torcedor dono do carrinho</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="expiresAt" type="java.util.Date">
					<description>Quando a reserva vence</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="matchdaySeatHoldProduct" unique="true">
					<key attribute="product"/>
				</index>
				<index name="matchdaySeatHoldExpires">
					<key attribute="expiresAt"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Linha do tempo do sócio-torcedor: adesão, suspensão por inadimplência,
			regularização, cancelamento e observações. Criar um evento de Suspensão ou
			Regularização (Backoffice, Claude ou cartão novo na loja) aplica a mudança
			no torcedor (grupo socio-suspenso) pelo SocioEventInterceptor.
		-->
		<itemtype code="SocioEvent" extends="GenericItem" autocreate="true" generate="true">
			<description>Evento do sócio-torcedor</description>
			<deployment table="socioevents" typecode="25904"/>
			<attributes>
				<attribute qualifier="customer" type="Customer">
					<description>Torcedor</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="type" type="SocioEventType">
					<description>Tipo do evento</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="date" type="java.util.Date">
					<description>Quando aconteceu</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="plan" type="SocioPlan">
					<description>Plano do torcedor no momento do evento</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="origin" type="java.lang.String">
					<description>Onde nasceu: Loja, Backoffice, Claude ou Sistema</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="author" type="java.lang.String">
					<description>Usuário que registrou</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="note" type="java.lang.String">
					<description>Motivo ou observação</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="result" type="java.lang.String">
					<description>O que o evento mudou no torcedor</description>
					<persistence type="property"/>
				</attribute>
				<!-- Regras de saída (item 5): valores do cancelamento confirmado -->
				<attribute qualifier="refundAmount" type="java.lang.Double">
					<description>Reembolso no cancelamento dentro do prazo de arrependimento (R$)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="fineAmount" type="java.lang.Double">
					<description>Multa no cancelamento fora do prazo de arrependimento (R$)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioEventCustomer">
					<key attribute="customer"/>
				</index>
			</indexes>
		</itemtype>
		<!--
			Elegibilidade para comprar ingresso: cada tentativa de pôr uma poltrona no
			carrinho, aprovada ou negada, com as condições conferidas (plano, situação,
			janela da onda, biometria e limite por jogo) e os motivos da negativa.
			Gravado pelo SocioEligibilityService. Em modo observação (padrão) nada é
			recusado; com flamengo.socio.elegibilidade.bloqueio=true a tentativa negada
			é recusada com o motivo.
		-->
		<itemtype code="SocioEligibilityDecision" extends="GenericItem" autocreate="true" generate="true">
			<description>Decisão de elegibilidade para comprar ingresso</description>
			<deployment table="socioeligibility" typecode="25905"/>
			<attributes>
				<attribute qualifier="date" type="java.util.Date">
					<description>Quando o torcedor tentou</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="customer" type="Customer">
					<description>Torcedor</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="gameCode" type="java.lang.String">
					<description>Código do jogo (JOGO-aaaammdd-ADV)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="game" type="MatchdayGame">
					<description>Jogo</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="product" type="Product">
					<description>Poltrona</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cartCode" type="java.lang.String">
					<description>Carrinho</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="eligible" type="java.lang.Boolean">
					<description>Pode comprar: todas as condições atendidas</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="blocked" type="java.lang.Boolean">
					<description>A compra foi recusada (só com o bloqueio ligado)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="reasons" type="java.lang.String">
					<description>Motivos da negativa, um por linha (vazio quando aprovado)</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="checks" type="java.lang.String">
					<description>Todas as condições conferidas, uma por linha</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="plan" type="SocioPlan">
					<description>Plano considerado (inclui plano no carrinho)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="memberWave" type="java.lang.Integer">
					<description>Onda do torcedor (4 = venda geral)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="openWave" type="java.lang.Integer">
					<description>Onda aberta no jogo naquele momento (0 = nenhuma; 4 = venda geral)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="tickets" type="java.lang.Integer">
					<description>Ingressos do jogo que o torcedor já tinha (pedidos e carrinho)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="ticketLimit" type="java.lang.Integer">
					<description>Limite de ingressos por jogo para o torcedor</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="origin" type="java.lang.String">
					<description>Onde nasceu a tentativa (Carrinho)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioEligibilityCustomer">
					<key attribute="customer"/>
				</index>
				<index name="socioEligibilityDate">
					<key attribute="date"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Convidado nominal do sócio-torcedor: o titular dá nome às vagas de convidado
			contratadas na compra do plano (Minha conta › Meu sócio-torcedor › Meus
			convidados). Tirar o convidado ou cancelar o plano só encerra o registro
			(active=false, until, endReason): o histórico fica.
		-->
		<itemtype code="SocioGuest" extends="GenericItem" autocreate="true" generate="true">
			<description>Convidado do sócio-torcedor</description>
			<deployment table="socioguests" typecode="25906"/>
			<attributes>
				<attribute qualifier="customer" type="Customer">
					<description>Titular (sócio que cadastrou o convidado)</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="name" type="java.lang.String">
					<description>Nome completo do convidado</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cpf" type="java.lang.String">
					<description>CPF do convidado, só dígitos</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="email" type="java.lang.String">
					<description>E-mail do convidado</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="phone" type="java.lang.String">
					<description>Celular do convidado, só dígitos (opcional)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="birthDate" type="java.util.Date">
					<description>Data de nascimento</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="plan" type="SocioPlan">
					<description>Plano do titular quando o convidado foi cadastrado</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="active" type="java.lang.Boolean">
					<description>Convidado em vigor (false = encerrado)</description>
					<modifiers optional="false"/>
					<defaultvalue>Boolean.TRUE</defaultvalue>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="since" type="java.util.Date">
					<description>Cadastrado em</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="until" type="java.util.Date">
					<description>Encerrado em</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="endReason" type="java.lang.String">
					<description>Motivo do encerramento (retirado pelo titular, cancelamento do plano)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioGuestCustomer">
					<key attribute="customer"/>
				</index>
				<index name="socioGuestCpf">
					<key attribute="cpf"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Termo de adesão do programa Nação, versionado. A versão atual é a última com
			"Publicado em" preenchido (até agora); rascunho = sem data. O gestor cadastra
			e publica no Backoffice (Sócio-Torcedor › Termo do Nação).
		-->
		<itemtype code="SocioTermVersion" extends="GenericItem" autocreate="true" generate="true">
			<description>Versão do Termo do Nação</description>
			<deployment table="socioterms" typecode="25907"/>
			<attributes>
				<attribute qualifier="version" type="java.lang.String">
					<description>Versão (ex.: v2026.10)</description>
					<modifiers optional="false" unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="title" type="localized:java.lang.String">
					<description>Título do Termo</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="text" type="localized:java.lang.String">
					<description>Texto do Termo (parágrafos separados por linha em branco)</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="summary" type="localized:java.lang.String">
					<description>O que mudou nesta versão (aviso na área do sócio)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="publishedAt" type="java.util.Date">
					<description>Publicado em (vazio = rascunho)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioTermVersionCode" unique="true">
					<key attribute="version"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Aceite do Termo: no checkout da adesão (carrinho com plano, depois ganha o
			número do pedido), na área do sócio (versão nova) ou na migração (sócios que
			já existiam quando o Termo passou a valer). Gravado pelo SocioTermService.
		-->
		<itemtype code="SocioTermAcceptance" extends="GenericItem" autocreate="true" generate="true">
			<description>Aceite do Termo do Nação</description>
			<deployment table="sociotermaccepts" typecode="25908"/>
			<attributes>
				<attribute qualifier="customer" type="Customer">
					<description>Torcedor</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="termVersion" type="SocioTermVersion">
					<description>Versão aceita</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="date" type="java.util.Date">
					<description>Quando aceitou</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="origin" type="java.lang.String">
					<description>Onde aceitou: Checkout, Área do sócio ou Migração</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="plan" type="SocioPlan">
					<description>Plano do aceite (comprado no pedido ou o atual do sócio)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cartCode" type="java.lang.String">
					<description>Carrinho em que aceitou (checkout)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="orderCode" type="java.lang.String">
					<description>Pedido da adesão (preenchido ao fechar o pedido)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioTermAcceptCustomer">
					<key attribute="customer"/>
				</index>
				<index name="socioTermAcceptCart">
					<key attribute="cartCode"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Ingresso do convidado: a poltrona no carrinho/pedido do titular aponta para o
			convidado que vai usá-la (vazio = o próprio titular). O nome fica gravado em
			ticketHolder para continuar no pedido mesmo que o convidado saia depois.
			Copiados do carrinho para o pedido pelo clone padrão do SAP Commerce.
		-->
		<itemtype code="AbstractOrderEntry" autocreate="false" generate="false">
			<attributes>
				<attribute qualifier="socioGuest" type="SocioGuest">
					<description>Convidado do sócio que vai usar este ingresso (vazio = o titular)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="ticketHolder" type="java.lang.String">
					<description>Nome de quem vai usar o ingresso (convidado), gravado na compra</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
		</itemtype>

		<!--
			Forma de pagamento do plano (item 7 do plano de evolução): escolhida no
			checkout quando há plano no carrinho e copiada para o pedido pelo clone padrão.
			CARTAO_ANUAL, PIX e BOLETO cobram o ano inteiro (12 mensalidades do plano e dos
			convidados). Pix e boleto ficam aguardando pagamento até a confirmação
			(socioPaymentConfirmedAt); só então o torcedor vira sócio.
		-->
		<itemtype code="AbstractOrder" autocreate="false" generate="false">
			<attributes>
				<attribute qualifier="socioPaymentMethod" type="SocioPaymentMethod">
					<description>Forma de pagamento do plano (vazio = cartão, mensalidade, como antes)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="socioInstallments" type="java.lang.Integer">
					<description>Parcelas no cartão (ano inteiro)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="socioPaymentDue" type="java.util.Date">
					<description>Vencimento do Pix ou do boleto</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="socioPaymentCode" type="java.lang.String">
					<description>Pix copia e cola ou linha digitável do boleto (fictícios)</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="socioPaymentConfirmedAt" type="java.util.Date">
					<description>Pagamento do Pix ou do boleto confirmado (vazio = aguardando)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
		</itemtype>

		<!--
			Contrato do sócio (item 6 do plano de evolução): vigência de 12 meses,
			renovação automática e o plano da próxima vigência (downgrade agendado).
			Um por torcedor; criado na primeira escolha do sócio ou na virada. Sem
			contrato, a vigência sai do pedido mais novo do plano (como antes).
		-->
		<itemtype code="SocioContract" extends="GenericItem" autocreate="true" generate="true">
			<description>Contrato (vigência) do sócio-torcedor</description>
			<deployment table="sociocontracts" typecode="25909"/>
			<attributes>
				<attribute qualifier="customer" type="Customer">
					<description>Torcedor</description>
					<modifiers optional="false" unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="plan" type="SocioPlan">
					<description>Plano da vigência atual</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="start" type="java.util.Date">
					<description>Início da vigência</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="end" type="java.util.Date">
					<description>Fim da vigência (12 meses depois do início)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="autoRenew" type="java.lang.Boolean">
					<description>Renova sozinho no fim da vigência</description>
					<defaultvalue>Boolean.TRUE</defaultvalue>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="nextPlan" type="SocioPlan">
					<description>Plano da próxima vigência (mudança para um plano menor agendada)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="origin" type="java.lang.String">
					<description>De onde veio a vigência: pedido da adesão ou renovação</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="renewals" type="java.lang.Integer">
					<description>Renovações feitas</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="endedAt" type="java.util.Date">
					<description>Encerrado sem renovação (vazio enquanto vigente)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioContractCustomer" unique="true">
					<key attribute="customer"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Pontos e experiências (item 8 do plano de evolução): vitrine de experiências
			que o sócio resgata com pontos. O gestor cadastra no Backoffice (Sócio-Torcedor ›
			Experiências). Saldo = pontos ganhos nos pedidos desde a adesão (ingressos e
			produtos) menos os resgates não cancelados; nada de saldo gravado.
		-->
		<itemtype code="SocioExperience" extends="GenericItem" autocreate="true" generate="true">
			<description>Experiência resgatável com pontos do sócio-torcedor</description>
			<deployment table="socioexperiences" typecode="25910"/>
			<attributes>
				<attribute qualifier="code" type="java.lang.String">
					<description>Código da experiência</description>
					<modifiers optional="false" unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="name" type="localized:java.lang.String">
					<description>Nome na vitrine</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="description" type="localized:java.lang.String">
					<description>O que o sócio ganha e como usa</description>
					<persistence type="property">
						<columntype>
							<value>HYBRIS.LONG_STRING</value>
						</columntype>
					</persistence>
				</attribute>
				<attribute qualifier="points" type="java.lang.Integer">
					<description>Pontos para resgatar</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="stock" type="java.lang.Integer">
					<description>Quantidade total (vazio = sem limite); resgates cancelados voltam</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="minPlan" type="SocioPlan">
					<description>Plano mínimo pela mensalidade (vazio = qualquer plano)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="active" type="java.lang.Boolean">
					<description>Aparece na vitrine</description>
					<defaultvalue>Boolean.TRUE</defaultvalue>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="sortOrder" type="java.lang.Integer">
					<description>Ordem na vitrine</description>
					<persistence type="property"/>
				</attribute>
				<!-- Venda na loja (item 9) -->
				<attribute qualifier="price" type="java.lang.Double">
					<description>Preço na loja em R$ (vazio = só resgate com pontos)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="product" type="Product">
					<description>Produto da loja gerado ao salvar (catálogo Online, categoria Experiências)</description>
					<modifiers write="true" read="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="statusMessage" type="java.lang.String">
					<description>Resultado da última publicação na loja</description>
					<persistence type="property"/>
				</attribute>
				<!-- Imagem da vitrine (04/11): uma foto horizontal (ex.: 1200x675); copiada para o produto EXP- -->
				<attribute qualifier="image" type="Media">
					<description>Imagem da experiência na vitrine (horizontal, ex.: 1200x675)</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioExperienceCode" unique="true">
					<key attribute="code"/>
				</index>
			</indexes>
		</itemtype>

		<!--
			Resgate de experiência com pontos (item 8): na loja (área do sócio) ou pelo
			Claude. Gera um voucher e um evento na linha do tempo. O gestor cancela
			preenchendo "Cancelado em": os pontos e a vaga voltam.
		-->
		<itemtype code="SocioRedemption" extends="GenericItem" autocreate="true" generate="true">
			<description>Resgate de experiência com pontos</description>
			<deployment table="socioredemptions" typecode="25911"/>
			<attributes>
				<attribute qualifier="voucher" type="java.lang.String">
					<description>Código do voucher (apresentado para usar a experiência)</description>
					<modifiers optional="false" unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="customer" type="Customer">
					<description>Torcedor</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="experience" type="SocioExperience">
					<description>Experiência resgatada</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="points" type="java.lang.Integer">
					<description>Pontos usados</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="date" type="java.util.Date">
					<description>Quando resgatou</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="plan" type="SocioPlan">
					<description>Plano do sócio no resgate</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="origin" type="java.lang.String">
					<description>Onde resgatou: Loja ou Claude</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cancelledAt" type="java.util.Date">
					<description>Cancelado em (vazio = válido); pontos e vaga voltam</description>
					<persistence type="property"/>
				</attribute>
				<!-- Experiências na loja (item 9) -->
				<attribute qualifier="orderCode" type="java.lang.String">
					<description>Pedido da compra (vazio = resgate com pontos)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="amount" type="java.lang.Double">
					<description>Valor pago na compra (R$)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="usedAt" type="java.util.Date">
					<description>Voucher validado (usado) em; não vale de novo</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="usedBy" type="java.lang.String">
					<description>Quem validou o voucher</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cancelledBy" type="java.lang.String">
					<description>Quem cancelou</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cancelReason" type="java.lang.String">
					<description>Motivo do cancelamento</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="socioRedemptionCustomer">
					<key attribute="customer"/>
				</index>
				<index name="socioRedemptionVoucher" unique="true">
					<key attribute="voucher"/>
				</index>
			</indexes>
		</itemtype>


		<!--
			Ingresso vendido (item 10 do plano de evolução): um por poltrona, criado ao fechar o
			pedido (e por script para os pedidos antigos). O gestor de jogos troca a poltrona,
			troca quem vai usar, cancela com reembolso e marca como utilizado; cada ação vai
			para o histórico (MatchdayTicketEvent). O pedido em si não muda.
		-->
		<itemtype code="MatchdayTicket" extends="GenericItem" autocreate="true" generate="true">
			<description>Ingresso vendido (uma poltrona de um pedido)</description>
			<deployment table="matchdaytickets" typecode="25912"/>
			<attributes>
				<attribute qualifier="code" type="java.lang.String">
					<description>Código do ingresso</description>
					<modifiers optional="false" unique="true"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="game" type="MatchdayGame">
					<description>Jogo</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="seat" type="Product">
					<description>Poltrona (produto)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="sector" type="java.lang.String">
					<description>Setor</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="seatLabel" type="java.lang.String">
					<description>Poltrona como aparece para o torcedor</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="orderCode" type="java.lang.String">
					<description>Pedido</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="entryNumber" type="java.lang.Integer">
					<description>Linha do pedido</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="customer" type="Customer">
					<description>Comprador</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="holder" type="java.lang.String">
					<description>Quem vai usar (nome)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="guest" type="SocioGuest">
					<description>Convidado do sócio que vai usar (vazio = titular)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="price" type="java.lang.Double">
					<description>Valor pago (R$)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="memberDiscount" type="java.lang.Double">
					<description>Desconto de sócio aplicado (R$)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="status" type="MatchdayTicketStatus">
					<description>Situação</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="soldAt" type="java.util.Date">
					<description>Vendido em</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="cancelledAt" type="java.util.Date">
					<description>Cancelado em</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="refundAmount" type="java.lang.Double">
					<description>Valor reembolsado (R$)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="usedAt" type="java.util.Date">
					<description>Utilizado (entrada no estádio) em</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="matchdayTicketCode" unique="true">
					<key attribute="code"/>
				</index>
				<index name="matchdayTicketOrder">
					<key attribute="orderCode"/>
				</index>
				<index name="matchdayTicketGame">
					<key attribute="game"/>
				</index>
			</indexes>
		</itemtype>

		<itemtype code="MatchdayTicketEvent" extends="GenericItem" autocreate="true" generate="true">
			<description>Evento no histórico do ingresso (venda e ações do gestor)</description>
			<deployment table="matchdayticketevents" typecode="25913"/>
			<attributes>
				<attribute qualifier="ticket" type="MatchdayTicket">
					<description>Ingresso</description>
					<modifiers optional="false"/>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="type" type="MatchdayTicketEventType">
					<description>O que aconteceu</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="date" type="java.util.Date">
					<description>Quando</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="author" type="java.lang.String">
					<description>Quem fez (gestor, torcedor ou sistema)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="fromValue" type="java.lang.String">
					<description>Antes (ex.: poltrona ou titular anterior)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="toValue" type="java.lang.String">
					<description>Depois</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="amount" type="java.lang.Double">
					<description>Valor (ex.: reembolso)</description>
					<persistence type="property"/>
				</attribute>
				<attribute qualifier="note" type="java.lang.String">
					<description>Observação</description>
					<persistence type="property"/>
				</attribute>
			</attributes>
			<indexes>
				<index name="matchdayTicketEventTicket">
					<key attribute="ticket"/>
				</index>
			</indexes>
		</itemtype>

	</itemtypes>
</items>
