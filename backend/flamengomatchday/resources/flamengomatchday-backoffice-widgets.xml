<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Perspectiva "Matchday Flamengo" no Backoffice: aparece na lista do cabeçalho
  (ao lado de Administration Cockpit e Product Cockpit) para quem tem a
  autoridade "matchdayperspective" (o atributo access compara com as
  authorities do BackofficeRole, não com o uid): dada ao administrador
  (backofficeadministratorrole) e ao papel "Gestor de jogos" no impex do papel.
  Mesmo desenho da Administration Cockpit (menu à esquerda, busca e lista no
  centro, ficha embaixo), com menu próprio (contexto matchday-explorer-tree em
  flamengomatchday-backoffice-config.xml). Ao abrir a perspectiva, "Jogos" já
  vem selecionado.
  O centro é um perspectiveContainer com duas telas: a lista com a ficha
  (matchdayContainer, para Jogos e Reservas de poltrona) e os relatórios
  (matchdayReport, para Relatórios), trocadas pelo clique na árvore.
  Perspectiva "Sócio-Torcedor" (mais abaixo): mesmo desenho, com menu Planos
  (contexto socio-explorer-tree), para o papel "Gestor do sócio-torcedor" e o admin.
-->
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/widgets.xsd">

	<widget-extension widgetId="backofficeMainSlot">
		<widget id="matchdayPerspective" widgetDefinitionId="com.hybris.cockpitng.borderlayout" slotId="perspectives"
				title="Matchday Flamengo" template="false" access="matchdayperspective">

			<!-- Menu à esquerda -->
			<widget id="matchdayExplorerTree" widgetDefinitionId="com.hybris.cockpitng.widgets.common.explorertree"
					slotId="leftSlot" template="false" title="Matchday Flamengo">
				<!-- clique num tipo (Jogos, Reservas): manda o tipo para a busca -->
				<widget id="matchdayTreeSelection" widgetDefinitionId="com.hybris.cockpitng.conditionevaluator"
						slotId="cockpitWidgetChildrenInvisible" template="false">
					<widget id="matchdayTypeName" widgetDefinitionId="com.hybris.cockpitng.widgets.common.propextractor"
							slotId="cockpitWidgetChildrenInvisible" template="false">
						<setting key="expression" type="String">name</setting>
						<setting key="socketDataType_$T" type="String">java.lang.String</setting>
						<virtual-sockets/>
					</widget>
					<setting key="expression" type="String">#root instanceof T(com.hybris.cockpitng.tree.node.TypeNode)</setting>
					<setting key="socketDataType_$T" type="String">java.lang.Object</setting>
					<virtual-sockets/>
				</widget>
				<!-- clique em Jogos ou Reservas: mostra a lista -->
				<widget id="matchdayShowList" widgetDefinitionId="com.hybris.cockpitng.widgets.common.propextractor"
						slotId="cockpitWidgetChildrenInvisible" template="false">
					<setting key="expression" type="String">'matchdayContainer'</setting>
					<setting key="socketDataType_$T" type="String">java.lang.String</setting>
					<virtual-sockets/>
				</widget>
				<!-- clique em "Relatórios": mostra os relatórios -->
				<widget id="matchdayReportsSelection" widgetDefinitionId="com.hybris.cockpitng.conditionevaluator"
						slotId="cockpitWidgetChildrenInvisible" template="false">
					<widget id="matchdayShowReport" widgetDefinitionId="com.hybris.cockpitng.widgets.common.propextractor"
							slotId="cockpitWidgetChildrenInvisible" template="false">
						<setting key="expression" type="String">'matchdayReport'</setting>
						<setting key="socketDataType_$T" type="String">java.lang.String</setting>
						<virtual-sockets/>
					</widget>
					<setting key="expression" type="String">#root != null &amp;&amp; "matchday.tree.reports".equals(#root.id)</setting>
					<setting key="socketDataType_$T" type="String">java.lang.Object</setting>
					<virtual-sockets/>
				</widget>
				<!-- ao abrir a perspectiva, seleciona "Jogos" -->
				<widget id="matchdayPerspectiveChecker" widgetDefinitionId="com.hybris.cockpitng.conditionevaluator"
						slotId="cockpitWidgetChildrenInvisible" template="false">
					<widget id="matchdayGamesSelector" widgetDefinitionId="com.hybris.cockpitng.widgets.common.propextractor"
							slotId="cockpitWidgetChildrenInvisible" template="false">
						<setting key="expression" type="String">new com.hybris.backoffice.navigation.TreeNodeSelector("matchday.tree.games", true)</setting>
						<setting key="socketDataType_$T" type="String">java.lang.Object</setting>
						<virtual-sockets/>
					</widget>
					<setting key="expression" type="String">#root != null &amp;&amp; "matchdayPerspective".equals(#root.id)</setting>
					<setting key="socketDataType_$T" type="String">java.lang.Object</setting>
					<virtual-sockets/>
				</widget>
				<setting key="explorerTreeConfigCtx" type="String">matchday-explorer-tree</setting>
				<setting key="allowFilteringEntries" type="Boolean">false</setting>
				<setting key="widgetStyleClass" type="String">yw-explorerTree-sideNavigation</setting>
				<setting key="widgetMold" type="String" value="light"/>
				<virtual-sockets/>
			</widget>

			<!-- Centro: lista com ficha ou relatórios -->
			<widget id="matchdayContent" widgetDefinitionId="com.hybris.backoffice.perspectiveContainer"
					slotId="centerSlot" template="false">

				<!-- Busca e lista no centro, ficha embaixo (primeira tela: aparece por padrão) -->
