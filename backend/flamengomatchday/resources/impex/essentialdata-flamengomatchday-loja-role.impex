# Só o catálogo do Flamengo (07/11). A lista de produtos do Backoffice (Solr) segue os catálogos que o
# usuário lê (readPrincipals); por isso o gestor não fica no employeegroup (ver acima) e lê só o
# flamengoProductCatalog. As restrições abaixo valem só para o lojamanagerrole (só o gestor.loja) e
# repõem as do employeegroup (Backend_visibility, HideSystemPrincipals), limitadas ao Flamengo, para as
# telas que usam a busca no banco. Preço e estoque sem versão de catálogo são ligados ao produto pelo código.
INSERT_UPDATE SearchRestriction;code[unique=true];restrictedType(code)[unique=true];principal(uid);active;generate;query
;Loja_somente_flamengo;Principal;lojamanagerrole;true;true;{uid} not in ( 'anonymous', 'admin', 'admingroup' )
;Loja_somente_flamengo;AbstractAsSearchProfile;lojamanagerrole;true;true;{catalogVersion} IN ( ?session.catalogversions ) OR {catalogVersion} IS NULL
;Loja_somente_flamengo;AbstractAsSearchConfiguration;lojamanagerrole;true;true;{catalogVersion} IN ( ?session.catalogversions ) OR {catalogVersion} IS NULL
;Loja_somente_flamengo;AbstractAsItemConfiguration;lojamanagerrole;true;true;{catalogVersion} IN ( ?session.catalogversions ) OR {catalogVersion} IS NULL
;Loja_somente_flamengo;AsSearchProfileActivationSet;lojamanagerrole;true;true;{catalogVersion} IN ( ?session.catalogversions ) OR {catalogVersion} IS NULL
;Loja_somente_flamengo;Product;lojamanagerrole;true;true;{catalogVersion} IN ({{SELECT {cv:pk} FROM {CatalogVersion AS cv JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}})
;Loja_somente_flamengo;Category;lojamanagerrole;true;true;{catalogVersion} IN ({{SELECT {cv:pk} FROM {CatalogVersion AS cv JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}})
;Loja_somente_flamengo;Keyword;lojamanagerrole;true;true;{catalogVersion} IN ({{SELECT {cv:pk} FROM {CatalogVersion AS cv JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}})
;Loja_somente_flamengo;PriceRow;lojamanagerrole;true;true;{catalogVersion} IN ({{SELECT {cv:pk} FROM {CatalogVersion AS cv JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}}) OR ({catalogVersion} IS NULL AND {productId} IN ({{SELECT {p:code} FROM {Product AS p JOIN CatalogVersion AS cv ON {p:catalogVersion}={cv:pk} JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}}))
;Loja_somente_flamengo;DiscountRow;lojamanagerrole;true;true;{catalogVersion} IN ({{SELECT {cv:pk} FROM {CatalogVersion AS cv JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}}) OR ({catalogVersion} IS NULL AND {productId} IN ({{SELECT {p:code} FROM {Product AS p JOIN CatalogVersion AS cv ON {p:catalogVersion}={cv:pk} JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}}))
;Loja_somente_flamengo;StockLevel;lojamanagerrole;true;true;{productCode} IN ({{SELECT {p:code} FROM {Product AS p JOIN CatalogVersion AS cv ON {p:catalogVersion}={cv:pk} JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}})
;Loja_somente_flamengo;Media;lojamanagerrole;true;true;{catalogVersion} IN ({{SELECT {cv:pk} FROM {CatalogVersion AS cv JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}}) OR {catalogVersion} IS NULL
;Loja_somente_flamengo;MediaContainer;lojamanagerrole;true;true;{catalogVersion} IN ({{SELECT {cv:pk} FROM {CatalogVersion AS cv JOIN Catalog AS c ON {cv:catalog}={c:pk}} WHERE {c:id}='flamengoProductCatalog'}}) OR {catalogVersion} IS NULL
;Loja_somente_flamengo;CatalogVersion;lojamanagerrole;true;true;{catalog} IN ({{SELECT {c:pk} FROM {Catalog AS c} WHERE {c:id}='flamengoProductCatalog'}})
;Loja_somente_flamengo;Catalog;lojamanagerrole;true;true;{id} = 'flamengoProductCatalog'
