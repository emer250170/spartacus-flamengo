# Rotina que libera poltronas com reserva vencida, a cada minuto
INSERT_UPDATE ServicelayerJob;code[unique=true];springId
;seatHoldExpiryJob;seatHoldExpiryJob

INSERT_UPDATE CronJob;code[unique=true];job(code);sessionLanguage(isocode);sessionUser(uid);logToDatabase[default=false];logToFile[default=false]
;seatHoldExpiryCronJob;seatHoldExpiryJob;pt;admin

INSERT_UPDATE Trigger;cronjob(code)[unique=true];cronExpression;active
;seatHoldExpiryCronJob;0 * * * * ?;true
