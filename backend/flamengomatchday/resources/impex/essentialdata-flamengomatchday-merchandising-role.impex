# Papel "Gestor de merchandising" (item 11 do plano de evolução): entra no Backoffice só na
# perspectiva "Merchandising Flamengo" (flamengomatchday-backoffice-widgets.xml, access=
# "merchandisingperspective") e cria e mantém promoções (regras, modelos, grupos) e cupons.
# Usuário: Employee gestor.merchandising, criado SEM senha (a senha é definida no Backoffice,
# Usuário › Funcionários, e não fica no repositório). Importar à parte (base64 + ImportConfig),
# por causa do $START_USERRIGHTS.

INSERT_UPDATE BackofficeRole;uid[unique=true];locname[lang=pt];locname[lang=en];description;authorities;backOfficeLoginDisabled[default=false]
;merchandisingmanagerrole;Gestor de merchandising;Merchandising manager;Cria e mantém promoções, regras de desconto e cupons;merchandisingmanagerrole,merchandisingperspective;

# A perspectiva também para o administrador
UPDATE BackofficeRole;uid[unique=true];authorities[mode=append]
;backofficeadministratorrole;merchandisingperspective

# loginDisabled=false: sem a coluna, o Employee criado sem senha nasce com o login bloqueado
# ("Esse usuário não tem acesso ao backoffice"), mesmo depois de definir a senha.
INSERT_UPDATE Employee;uid[unique=true];name;groups(uid);sessionLanguage(isocode);backOfficeLoginDisabled;loginDisabled
;gestor.merchandising;Gestor de merchandising (demo);merchandisingmanagerrole;pt;false;false

# Promoções e cupons: cria e mantém. O resto (produtos, categorias, grupos de clientes,
# definições do construtor de regras e motor de regras): só leitura, para os seletores
# do construtor e a publicação.
