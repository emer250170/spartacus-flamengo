<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Tela "Jogos" do Backoffice (Matchday Flamengo) e, no fim, a tela "Planos"
  da perspectiva Sócio-Torcedor.
  Menu: Matchday Flamengo > Jogos e Reservas de poltrona.
  Rótulos em flamengomatchday-backoffice-labels; nomes de campos na
  localização do tipo (resources/localization).
-->
<config xmlns="http://www.hybris.com/cockpit/config"
		xmlns:list-view="http://www.hybris.com/cockpitng/component/listView"
		xmlns:advanced-search="http://www.hybris.com/cockpitng/config/advancedsearch"
		xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea"
		xmlns:wz="http://www.hybris.com/cockpitng/config/wizard-config"
		xmlns:explorer-tree="http://www.hybris.com/cockpitng/config/explorertree"
		xmlns:y="http://www.hybris.com/cockpit/config/hybris">

	<!-- Menu lateral -->
	<context merge-by="module" parent="auto" component="explorer-tree">
		<explorer-tree:explorer-tree>
			<explorer-tree:navigation-node id="matchday.tree.root">
				<explorer-tree:type-node id="matchday.tree.games" code="MatchdayGame"/>
				<explorer-tree:type-node id="matchday.tree.seatholds" code="SeatHold"/>
			</explorer-tree:navigation-node>
		</explorer-tree:explorer-tree>
	</context>

	<!--
	  Menu do papel "Gestor de jogos": sem merge-by, substitui a árvore inteira,
	  então o usuário só vê Matchday Flamengo.
	-->
	<context component="explorer-tree" principal="matchdaygamemanagerrole">
		<explorer-tree:explorer-tree>
			<explorer-tree:navigation-node id="matchday.tree.root">
				<explorer-tree:type-node id="matchday.tree.games" code="MatchdayGame"/>
				<explorer-tree:type-node id="matchday.tree.seatholds" code="SeatHold"/>
			</explorer-tree:navigation-node>
		</explorer-tree:explorer-tree>
	</context>

	<!-- Menu da perspectiva "Matchday Flamengo" (flamengomatchday-backoffice-widgets.xml); "Relatórios" abre o widget matchdayReport -->
	<context component="matchday-explorer-tree">
		<explorer-tree:explorer-tree>
			<explorer-tree:navigation-node id="matchday.tree.root">
				<explorer-tree:type-node id="matchday.tree.games" code="MatchdayGame"/>
				<explorer-tree:type-node id="matchday.tree.seatholds" code="SeatHold"/>
				<explorer-tree:navigation-node id="matchday.tree.reports"/>
			</explorer-tree:navigation-node>
		</explorer-tree:explorer-tree>
	</context>

	<!-- Como o jogo aparece em títulos e referências -->
	<context merge-by="type" parent="GenericItem" type="MatchdayGame" component="base">
		<y:base>
			<y:labels>
				<y:label>'Flamengo x ' + opponent + ' (' + code + ')'</y:label>
			</y:labels>
		</y:base>
	</context>

	<!-- Lista de jogos -->
	<context merge-by="type" parent="GenericItem" type="MatchdayGame" component="listview">
		<list-view:list-view>
			<list-view:column qualifier="code"/>
			<list-view:column qualifier="opponent"/>
			<list-view:column qualifier="kickoff"/>
			<list-view:column qualifier="competition"/>
			<list-view:column qualifier="status"/>
			<list-view:column qualifier="seatsAvailable"/>
			<list-view:column qualifier="seatsSold"/>
		</list-view:list-view>
	</context>

	<context merge-by="type" parent="GenericItem" type="MatchdayGame" component="advanced-search">
		<advanced-search:advanced-search>
			<advanced-search:field-list>
				<advanced-search:field name="opponent" selected="true"/>
				<advanced-search:field name="status" selected="true"/>
				<advanced-search:field name="kickoff" selected="true"/>
				<advanced-search:field name="code" selected="false"/>
				<advanced-search:field name="competition" selected="false"/>
			</advanced-search:field-list>
		</advanced-search:advanced-search>
	</context>

	<!-- Cadastro de jogo novo: 3 passos -->
	<!-- sem merge-by: não herda o assistente genérico do GenericItem -->
	<context type="MatchdayGame" component="create-wizard">
		<wz:flow id="MatchdayGameWizard" title="create.title(ctx.TYPE_CODE)">
			<wz:prepare id="matchdayGamePrepare">
				<wz:initialize property="newGame" type="ctx.TYPE_CODE"/>
			</wz:prepare>

			<wz:step id="matchdayStep1" label="matchday.wizard.step1" sublabel="matchday.wizard.step1.sub">
				<wz:content id="step1.content">
					<wz:property-list root="newGame">
						<wz:property qualifier="opponent" type="java.lang.String"/>
						<wz:property qualifier="kickoff" type="java.util.Date"/>
						<wz:property qualifier="competition" type="java.lang.String"/>
						<wz:property qualifier="venue" type="java.lang.String"/>
						<wz:property qualifier="presale" type="java.lang.Boolean"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="step1.navigation">
					<wz:cancel/>
					<wz:next visible="!#empty(newGame.opponent) AND newGame.kickoff != null"/>
				</wz:navigation>
			</wz:step>

			<wz:step id="matchdayStepWaves" label="matchday.wizard.waves" sublabel="matchday.wizard.waves.sub">
				<wz:content id="waves.content">
					<wz:property-list root="newGame">
						<wz:property qualifier="wave1Start" type="java.util.Date"/>
						<wz:property qualifier="wave2Start" type="java.util.Date"/>
						<wz:property qualifier="wave3Start" type="java.util.Date"/>
						<wz:property qualifier="generalSaleStart" type="java.util.Date"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="waves.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:next/>
				</wz:navigation>
			</wz:step>

			<wz:step id="matchdayStep2" label="matchday.wizard.step2" sublabel="matchday.wizard.step2.sub">
				<wz:content id="step2.content">
					<wz:property-list root="newGame">
						<wz:property qualifier="priceNorte" type="java.lang.Double"/>
						<wz:property qualifier="priceSul" type="java.lang.Double"/>
						<wz:property qualifier="priceLeste" type="java.lang.Double"/>
						<wz:property qualifier="priceOeste" type="java.lang.Double"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="step2.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:next visible="newGame.priceNorte != null AND newGame.priceSul != null AND newGame.priceLeste != null AND newGame.priceOeste != null"/>
				</wz:navigation>
			</wz:step>

			<wz:step id="matchdayStep3" label="matchday.wizard.step3" sublabel="matchday.wizard.step3.sub">
				<wz:content id="step3.content">
					<wz:property-list root="newGame">
						<wz:property qualifier="status" editor="com.hybris.cockpitng.editor.nonoptionalenum"/>
						<wz:property qualifier="simulatedSoldPercent" type="java.lang.Integer"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="step3.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:done visible="!#empty(newGame.opponent) AND newGame.kickoff != null AND newGame.status != null">
						<wz:save property="newGame"/>
					</wz:done>
				</wz:navigation>
			</wz:step>
		</wz:flow>
	</context>

	<!-- Ficha do jogo -->
	<context merge-by="type" parent="GenericItem" type="MatchdayGame" component="editor-area">
		<editorArea:editorArea>
			<editorArea:essentials>
				<editorArea:essentialSection name="matchday.editor.essentials">
					<editorArea:attribute qualifier="code" readonly="true"/>
					<editorArea:attribute qualifier="opponent"/>
					<editorArea:attribute qualifier="kickoff"/>
					<editorArea:attribute qualifier="status"/>
				</editorArea:essentialSection>
			</editorArea:essentials>
			<editorArea:tab name="matchday.editor.tab">
				<editorArea:section name="matchday.editor.match">
					<editorArea:attribute qualifier="competition"/>
					<editorArea:attribute qualifier="venue"/>
					<editorArea:attribute qualifier="presale"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.waves">
					<editorArea:attribute qualifier="wave1Start"/>
					<editorArea:attribute qualifier="wave2Start"/>
					<editorArea:attribute qualifier="wave3Start"/>
					<editorArea:attribute qualifier="generalSaleStart"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.prices">
					<editorArea:attribute qualifier="priceNorte"/>
					<editorArea:attribute qualifier="priceSul"/>
					<editorArea:attribute qualifier="priceLeste"/>
					<editorArea:attribute qualifier="priceOeste"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.sales">
					<editorArea:attribute qualifier="seatsTotal" readonly="true"/>
					<editorArea:attribute qualifier="seatsAvailable" readonly="true"/>
					<editorArea:attribute qualifier="seatsSold" readonly="true"/>
					<editorArea:attribute qualifier="product" readonly="true"/>
					<editorArea:attribute qualifier="statusMessage" readonly="true"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.demo">
					<editorArea:attribute qualifier="simulatedSoldPercent"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<!--
	  Ficha do jogo para o papel "Gestor de jogos": sem merge-by, não herda do
	  GenericItem a aba técnica "Administração" (PK, metadados, histórico de
	  alterações). O administrador continua vendo a aba.
	-->
	<context type="MatchdayGame" component="editor-area" principal="matchdaygamemanagerrole">
		<editorArea:editorArea>
			<editorArea:essentials>
				<editorArea:essentialSection name="matchday.editor.essentials">
					<editorArea:attribute qualifier="code" readonly="true"/>
					<editorArea:attribute qualifier="opponent"/>
					<editorArea:attribute qualifier="kickoff"/>
					<editorArea:attribute qualifier="status"/>
				</editorArea:essentialSection>
			</editorArea:essentials>
			<editorArea:tab name="matchday.editor.tab">
				<editorArea:section name="matchday.editor.match">
					<editorArea:attribute qualifier="competition"/>
					<editorArea:attribute qualifier="venue"/>
					<editorArea:attribute qualifier="presale"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.waves">
					<editorArea:attribute qualifier="wave1Start"/>
					<editorArea:attribute qualifier="wave2Start"/>
					<editorArea:attribute qualifier="wave3Start"/>
					<editorArea:attribute qualifier="generalSaleStart"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.prices">
					<editorArea:attribute qualifier="priceNorte"/>
					<editorArea:attribute qualifier="priceSul"/>
					<editorArea:attribute qualifier="priceLeste"/>
					<editorArea:attribute qualifier="priceOeste"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.sales">
					<editorArea:attribute qualifier="seatsTotal" readonly="true"/>
					<editorArea:attribute qualifier="seatsAvailable" readonly="true"/>
					<editorArea:attribute qualifier="seatsSold" readonly="true"/>
					<editorArea:attribute qualifier="product" readonly="true"/>
					<editorArea:attribute qualifier="statusMessage" readonly="true"/>
				</editorArea:section>
				<editorArea:section name="matchday.editor.demo">
					<editorArea:attribute qualifier="simulatedSoldPercent"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<!-- Reservas de poltrona -->
	<context merge-by="type" parent="GenericItem" type="SeatHold" component="listview">
		<list-view:list-view>
			<list-view:column qualifier="product"/>
			<list-view:column qualifier="cartCode"/>
			<list-view:column qualifier="user"/>
			<list-view:column qualifier="expiresAt"/>
		</list-view:list-view>
	</context>

	<context merge-by="type" parent="GenericItem" type="SeatHold" component="base">
		<y:base>
			<y:labels>
				<y:label>product.code + ' (' + cartCode + ')'</y:label>
			</y:labels>
		</y:base>
	</context>

	<!-- ============================ Sócio-Torcedor ============================ -->

	<!-- Menu da perspectiva "Sócio-Torcedor" (flamengomatchday-backoffice-widgets.xml); "Sócios" abre o widget socioMembers e "Relatórios" o socioReport -->
	<context component="socio-explorer-tree">
		<explorer-tree:explorer-tree>
			<explorer-tree:navigation-node id="socio.tree.root">
				<explorer-tree:type-node id="socio.tree.plans" code="SocioPlan"/>
				<explorer-tree:navigation-node id="socio.tree.members"/>
				<explorer-tree:type-node id="socio.tree.events" code="SocioEvent"/>
				<explorer-tree:navigation-node id="socio.tree.reports"/>
			</explorer-tree:navigation-node>
		</explorer-tree:explorer-tree>
	</context>

	<context merge-by="type" parent="GenericItem" type="SocioPlan" component="base">
		<y:base>
			<y:labels>
				<y:label>name + ' (' + code + ')'</y:label>
			</y:labels>
		</y:base>
	</context>

	<!-- Lista de planos -->
	<context merge-by="type" parent="GenericItem" type="SocioPlan" component="listview">
		<list-view:list-view>
			<list-view:column qualifier="name"/>
			<list-view:column qualifier="family"/>
			<list-view:column qualifier="monthlyPrice"/>
			<list-view:column qualifier="ticketDiscount"/>
			<list-view:column qualifier="storeDiscount"/>
			<list-view:column qualifier="wave"/>
			<list-view:column qualifier="maxGuests"/>
			<list-view:column qualifier="members"/>
			<list-view:column qualifier="status"/>
		</list-view:list-view>
	</context>

	<context merge-by="type" parent="GenericItem" type="SocioPlan" component="advanced-search">
		<advanced-search:advanced-search>
			<advanced-search:field-list>
				<advanced-search:field name="name" selected="true"/>
				<advanced-search:field name="family" selected="true"/>
				<advanced-search:field name="status" selected="true"/>
				<advanced-search:field name="code" selected="false"/>
			</advanced-search:field-list>
		</advanced-search:advanced-search>
	</context>

	<!-- Plano novo: 4 passos (sem merge-by: não herda o assistente genérico) -->
	<context type="SocioPlan" component="create-wizard">
		<wz:flow id="SocioPlanWizard" title="create.title(ctx.TYPE_CODE)">
			<wz:prepare id="socioPlanPrepare">
				<wz:initialize property="newPlan" type="ctx.TYPE_CODE"/>
			</wz:prepare>

			<wz:step id="socioStep1" label="socio.wizard.step1" sublabel="socio.wizard.step1.sub">
				<wz:content id="socioStep1.content">
					<wz:property-list root="newPlan">
						<wz:property qualifier="name"/>
						<wz:property qualifier="family" type="java.lang.String"/>
						<wz:property qualifier="monthlyPrice" type="java.lang.Double"/>
						<wz:property qualifier="slots" type="java.lang.Integer"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="socioStep1.navigation">
					<wz:cancel/>
					<wz:next visible="newPlan.monthlyPrice != null"/>
				</wz:navigation>
			</wz:step>

			<wz:step id="socioStep2" label="socio.wizard.step2" sublabel="socio.wizard.step2.sub">
				<wz:content id="socioStep2.content">
					<wz:property-list root="newPlan">
						<wz:property qualifier="wave" type="java.lang.Integer"/>
						<wz:property qualifier="ticketDiscount" type="java.lang.Integer"/>
						<wz:property qualifier="storeDiscount" type="java.lang.Integer"/>
						<wz:property qualifier="maxGuests" type="java.lang.Integer"/>
						<wz:property qualifier="guestPrice" type="java.lang.Double"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="socioStep2.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:next visible="newPlan.wave != null AND newPlan.ticketDiscount != null"/>
				</wz:navigation>
			</wz:step>

			<wz:step id="socioStep3" label="socio.wizard.step3" sublabel="socio.wizard.step3.sub">
				<wz:content id="socioStep3.content">
					<wz:property-list root="newPlan">
						<wz:property qualifier="summary"/>
						<wz:property qualifier="benefits" editor="com.hybris.cockpitng.editor.localized(com.hybris.cockpitng.editor.defaulttext)">
							<wz:editor-parameter>
								<wz:name>rows</wz:name>
								<wz:value>8</wz:value>
							</wz:editor-parameter>
						</wz:property>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="socioStep3.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:next/>
				</wz:navigation>
			</wz:step>

			<wz:step id="socioStep4" label="socio.wizard.step4" sublabel="socio.wizard.step4.sub">
				<wz:content id="socioStep4.content">
					<wz:property-list root="newPlan">
						<wz:property qualifier="status" editor="com.hybris.cockpitng.editor.nonoptionalenum"/>
						<wz:property qualifier="sortOrder" type="java.lang.Integer"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="socioStep4.navigation">
					<wz:cancel/>
					<wz:back/>
					<wz:done visible="newPlan.monthlyPrice != null AND newPlan.status != null">
						<wz:save property="newPlan"/>
					</wz:done>
				</wz:navigation>
			</wz:step>
		</wz:flow>
	</context>

	<!-- Ficha do plano -->
	<context merge-by="type" parent="GenericItem" type="SocioPlan" component="editor-area">
		<editorArea:editorArea>
			<editorArea:essentials>
				<editorArea:essentialSection name="socio.editor.essentials">
					<editorArea:attribute qualifier="name"/>
					<editorArea:attribute qualifier="code" readonly="true"/>
					<editorArea:attribute qualifier="status"/>
					<editorArea:attribute qualifier="members" readonly="true"/>
				</editorArea:essentialSection>
			</editorArea:essentials>
			<editorArea:tab name="socio.editor.tab">
				<editorArea:section name="socio.editor.plan">
					<editorArea:attribute qualifier="family"/>
					<editorArea:attribute qualifier="summary"/>
					<editorArea:attribute qualifier="sortOrder"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.price">
					<editorArea:attribute qualifier="monthlyPrice"/>
					<editorArea:attribute qualifier="slots"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.tickets">
					<editorArea:attribute qualifier="wave"/>
					<editorArea:attribute qualifier="ticketDiscount"/>
					<editorArea:attribute qualifier="maxGuests"/>
					<editorArea:attribute qualifier="guestPrice"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.store">
					<editorArea:attribute qualifier="storeDiscount"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.benefits">
					<editorArea:attribute qualifier="benefits" editor="com.hybris.cockpitng.editor.localized(com.hybris.cockpitng.editor.defaulttext)">
						<editorArea:editor-parameter>
							<editorArea:name>rows</editorArea:name>
							<editorArea:value>8</editorArea:value>
						</editorArea:editor-parameter>
					</editorArea:attribute>
				</editorArea:section>
				<editorArea:section name="socio.editor.publication">
					<editorArea:attribute qualifier="product" readonly="true"/>
					<editorArea:attribute qualifier="customerGroup" readonly="true"/>
					<editorArea:attribute qualifier="promotionCode" readonly="true"/>
					<editorArea:attribute qualifier="statusMessage" readonly="true"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.demo">
					<editorArea:attribute qualifier="demoBase"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<!-- Ficha do plano para o "Gestor do sócio-torcedor": sem merge-by, sem a aba técnica Administração -->
	<context type="SocioPlan" component="editor-area" principal="sociomanagerrole">
		<editorArea:editorArea>
			<editorArea:essentials>
				<editorArea:essentialSection name="socio.editor.essentials">
					<editorArea:attribute qualifier="name"/>
					<editorArea:attribute qualifier="code" readonly="true"/>
					<editorArea:attribute qualifier="status"/>
					<editorArea:attribute qualifier="members" readonly="true"/>
				</editorArea:essentialSection>
			</editorArea:essentials>
			<editorArea:tab name="socio.editor.tab">
				<editorArea:section name="socio.editor.plan">
					<editorArea:attribute qualifier="family"/>
					<editorArea:attribute qualifier="summary"/>
					<editorArea:attribute qualifier="sortOrder"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.price">
					<editorArea:attribute qualifier="monthlyPrice"/>
					<editorArea:attribute qualifier="slots"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.tickets">
					<editorArea:attribute qualifier="wave"/>
					<editorArea:attribute qualifier="ticketDiscount"/>
					<editorArea:attribute qualifier="maxGuests"/>
					<editorArea:attribute qualifier="guestPrice"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.store">
					<editorArea:attribute qualifier="storeDiscount"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.benefits">
					<editorArea:attribute qualifier="benefits" editor="com.hybris.cockpitng.editor.localized(com.hybris.cockpitng.editor.defaulttext)">
						<editorArea:editor-parameter>
							<editorArea:name>rows</editorArea:name>
							<editorArea:value>8</editorArea:value>
						</editorArea:editor-parameter>
					</editorArea:attribute>
				</editorArea:section>
				<editorArea:section name="socio.editor.publication">
					<editorArea:attribute qualifier="product" readonly="true"/>
					<editorArea:attribute qualifier="customerGroup" readonly="true"/>
					<editorArea:attribute qualifier="promotionCode" readonly="true"/>
					<editorArea:attribute qualifier="statusMessage" readonly="true"/>
				</editorArea:section>
				<editorArea:section name="socio.editor.demo">
					<editorArea:attribute qualifier="demoBase"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<!-- ===================== Eventos do sócio (linha do tempo) ===================== -->
	<!-- Suspensão e Regularização criadas aqui mudam o torcedor na hora (SocioEventInterceptor) -->

	<context merge-by="type" parent="GenericItem" type="SocioEvent" component="base">
		<y:base>
			<y:labels>
				<y:label>customer.uid + ' - ' + type</y:label>
			</y:labels>
		</y:base>
	</context>

	<context merge-by="type" parent="GenericItem" type="SocioEvent" component="listview">
		<list-view:list-view>
			<list-view:column qualifier="date"/>
			<list-view:column qualifier="customer"/>
			<list-view:column qualifier="type"/>
			<list-view:column qualifier="plan"/>
			<list-view:column qualifier="note"/>
			<list-view:column qualifier="result"/>
			<list-view:column qualifier="origin"/>
			<list-view:column qualifier="author"/>
		</list-view:list-view>
	</context>

	<context merge-by="type" parent="GenericItem" type="SocioEvent" component="advanced-search">
		<advanced-search:advanced-search>
			<advanced-search:field-list>
				<advanced-search:field name="customer" selected="true"/>
				<advanced-search:field name="type" selected="true"/>
				<advanced-search:field name="plan" selected="false"/>
				<advanced-search:field name="date" selected="false"/>
			</advanced-search:field-list>
			<advanced-search:sort-field name="date" asc="false"/>
		</advanced-search:advanced-search>
	</context>

	<!-- Evento novo: torcedor, tipo e motivo (data, autor, origem, plano e resultado são preenchidos ao salvar) -->
	<context type="SocioEvent" component="create-wizard">
		<wz:flow id="SocioEventWizard" title="create.title(ctx.TYPE_CODE)">
			<wz:prepare id="socioEventPrepare">
				<wz:initialize property="newEvent" type="ctx.TYPE_CODE"/>
			</wz:prepare>
			<wz:step id="socioEventStep1" label="socio.event.wizard.step1" sublabel="socio.event.wizard.step1.sub">
				<wz:content id="socioEventStep1.content">
					<wz:property-list root="newEvent">
						<wz:property qualifier="customer"/>
						<wz:property qualifier="type" editor="com.hybris.cockpitng.editor.nonoptionalenum"/>
						<wz:property qualifier="note" type="java.lang.String"/>
					</wz:property-list>
				</wz:content>
				<wz:navigation id="socioEventStep1.navigation">
					<wz:cancel/>
					<wz:done visible="newEvent.customer != null AND newEvent.type != null">
						<wz:save property="newEvent"/>
					</wz:done>
				</wz:navigation>
			</wz:step>
		</wz:flow>
	</context>

	<!-- Ficha do evento: só leitura depois de criado (o efeito já foi aplicado) -->
	<context type="SocioEvent" component="editor-area">
		<editorArea:editorArea>
			<editorArea:essentials>
				<editorArea:essentialSection name="socio.event.editor.essentials">
					<editorArea:attribute qualifier="customer" readonly="true"/>
					<editorArea:attribute qualifier="type" readonly="true"/>
					<editorArea:attribute qualifier="date" readonly="true"/>
				</editorArea:essentialSection>
			</editorArea:essentials>
			<editorArea:tab name="socio.event.editor.tab">
				<editorArea:section name="socio.event.editor.details">
					<editorArea:attribute qualifier="plan" readonly="true"/>
					<editorArea:attribute qualifier="note" readonly="true"/>
					<editorArea:attribute qualifier="result" readonly="true"/>
					<editorArea:attribute qualifier="origin" readonly="true"/>
					<editorArea:attribute qualifier="author" readonly="true"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

</config>
