<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  flamengomatchday: reserva de poltrona da jornada de matchday do Flamengo.
  Segura a poltrona quando o torcedor a coloca no carrinho, libera quando ele
  desiste ou o prazo vence e converte a reserva em venda ao fechar o pedido.
-->
<extensioninfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="extensioninfo.xsd">

    <extension abstractclassprefix="Generated" classprefix="Flamengomatchday" description="Matchday Flamengo: jogos e reserva de poltrona"
               jaloLogicFree="true" name="flamengomatchday" usemaven="false">

        <requires-extension name="commerceservices"/>
        <!-- perspectiva "Matchday Flamengo" no Backoffice; o widget de relatórios fica em backoffice/src e backoffice/resources -->
        <requires-extension name="backoffice"/>
        <!-- a validação de carrinho da loja vem da b2bacceleratorservices; carregar depois dela -->
        <requires-extension name="b2bacceleratorservices"/>
        <!-- 05/11: condição "Forma de pagamento" no construtor de promoções (tradutor do compilador de regras) -->
        <requires-extension name="ruleengineservices"/>
        <!-- 07/11: envio de e-mail com imagens embutidas (FlaEmailService estende o DefaultEmailService);
             já carregava antes desta extensão via b2bacceleratorservices -->
        <requires-extension name="acceleratorservices"/>
        <!-- 08/11: vouchers das experiências no OrderData (flamengomatchday-beans.xml e FlaOrderVoucherPopulator);
             já carregava antes desta extensão via acceleratorservices/OCC -->
        <requires-extension name="commercefacades"/>

        <coremodule generated="true" manager="de.hybris.platform.jalo.extension.GenericManager" packageroot="br.com.flamengo.matchday"/>

        <meta key="backoffice-module" value="true"/>

    </extension>

</extensioninfo>
