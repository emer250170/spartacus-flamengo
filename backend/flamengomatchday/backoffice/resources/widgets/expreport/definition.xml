<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Cockpit "Gestão de experiências" (item 9): resgates e vendas por experiência e por mês, pontos, receita e ocupação -->
<widget-definition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/widget-definition.xsd"
		id="br.com.flamengo.matchday.widgets.expreport">
	<name>Gestão de experiências - Relatório</name>
	<description>resgates e vendas por experiência e por mês, pontos, receita e ocupação</description>
	<defaultTitle>Relatório</defaultTitle>
	<author>Flamengo Matchday</author>
	<version>1.0</version>
	<view src="expreport.zul"/>
	<controller class="br.com.flamengo.matchday.backoffice.widgets.experiences.ExperienceReportController"/>
	<sockets>
		<!-- recarrega ao clicar no menu -->
		<input id="refresh" type="java.lang.Object"/>
	</sockets>
	<keywords>
		<keyword>Experiences</keyword>
	</keywords>
</widget-definition>
