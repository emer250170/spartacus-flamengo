<?xml version="1.0" encoding="UTF-8"?>
<!-- Vitrine das experiências: cards e formulário (ExperienceShowcaseController) -->
<widget xmlns="http://www.zkoss.org/2005/zul"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.hybris.com/schema/cockpitng/zul/zul.xsd"
		height="100%">
	<div height="100%" style="overflow:auto; box-sizing:border-box; padding:18px 24px; background:#f5f6f7;">
		<div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:12px; max-width:1320px;">
			<label value="${labels.showcaseTitle}" style="font-size:22px; font-weight:700; color:#1d2d3e; margin-right:auto;"/>
			<button id="newButton" label="${labels.showcaseNew}" sclass="y-btn-primary"/>
			<button id="refreshButton" label="${labels.refresh}"/>
		</div>
		<html id="summary"/>

		<!-- Formulário (nova ou editar) -->
		<div id="formPanel" visible="false"
				style="background:#fff; border:1px solid #d9dde3; border-radius:12px; padding:16px 18px; margin-bottom:16px; max-width:1320px;">
			<label id="formTitle" style="font-size:16px; font-weight:700; color:#1d2d3e;"/>
			<div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:10px 16px; margin-top:12px;">
				<div><label value="${labels.formCode}"/><separator/><textbox id="codeBox" width="100%" maxlength="40"/></div>
				<div><label value="${labels.formNamePt}"/><separator/><textbox id="namePtBox" width="100%"/></div>
				<div><label value="${labels.formNameEn}"/><separator/><textbox id="nameEnBox" width="100%"/></div>
				<div><label value="${labels.formPoints}"/><separator/><intbox id="pointsBox" width="100%" constraint="no negative"/></div>
				<div><label value="${labels.formPrice}"/><separator/><doublebox id="priceBox" width="100%" format="#,##0.00" constraint="no negative"/></div>
				<div><label value="${labels.formStock}"/><separator/><intbox id="stockBox" width="100%" constraint="no negative"/></div>
				<div><label value="${labels.formMinPlan}"/><separator/><listbox id="minPlanList" mold="select" rows="1" width="100%"/></div>
				<div><label value="${labels.formSort}"/><separator/><intbox id="sortBox" width="100%"/></div>
				<div style="display:flex; align-items:flex-end;"><checkbox id="activeCheck" label="${labels.formActive}"/></div>
			</div>
			<div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(400px,1fr)); gap:10px 16px; margin-top:10px;">
				<div><label value="${labels.formDescPt}"/><separator/><textbox id="descPtBox" rows="4" width="100%"/></div>
				<div><label value="${labels.formDescEn}"/><separator/><textbox id="descEnBox" rows="4" width="100%"/></div>
			</div>
			<div style="color:#556b82; font-size:12px; margin-top:8px;"><label value="${labels.formHint}"/></div>
			<div style="display:flex; gap:8px; align-items:center; margin-top:12px; flex-wrap:wrap;">
				<button id="saveButton" label="${labels.formSave}" sclass="y-btn-primary"/>
				<button id="cancelButton" label="${labels.formCancel}"/>
				<label id="formStatus" style="color:#556b82; font-size:12px;"/>
			</div>
		</div>

		<div id="cards" style="display:flex; flex-wrap:wrap; gap:14px; max-width:1320px;"/>
	</div>
</widget>
