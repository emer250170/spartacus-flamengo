<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Cockpit "Gestão de experiências" (item 9): validar voucher e lista de resgates e compras com ações -->
<widget-definition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/widget-definition.xsd"
		id="br.com.flamengo.matchday.widgets.expvouchers">
	<name>Gestão de experiências - Vouchers</name>
	<description>validar voucher e lista de resgates e compras com ações</description>
	<defaultTitle>Vouchers</defaultTitle>
	<author>Flamengo Matchday</author>
	<version>1.0</version>
	<view src="expvouchers.zul"/>
	<controller class="br.com.flamengo.matchday.backoffice.widgets.experiences.ExperienceVouchersController"/>
	<sockets>
		<!-- recarrega ao clicar no menu -->
		<input id="refresh" type="java.lang.Object"/>
	</sockets>
	<keywords>
		<keyword>Experiences</keyword>
	</keywords>
</widget-definition>
