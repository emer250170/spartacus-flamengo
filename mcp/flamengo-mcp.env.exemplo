# MCP "Loja Flamengo" na internet (modo --http). Copiar para /opt/flamengo-mcp/flamengo-mcp.env no
# servidor, preencher e proteger: chmod 600. Este arquivo de exemplo não leva senha nenhuma.
#
# Tokens: um por persona, gerados no servidor com   openssl rand -hex 32
# (são o que você cola no cadastro do conector no Claude; quem tiver o token usa a persona).
# Persona sem token ou sem login fica desligada.

MCP_HOST=127.0.0.1
MCP_PORT=8787
LOG_DIR=/logs

# /torcedor/mcp
MCP_TOKEN_TORCEDOR=
TORCEDOR_EMAIL=torcedor1@example.com
TORCEDOR_SENHA=COLOQUE_AQUI

# /gestor-socio/mcp
MCP_TOKEN_SOCIO=
SOCIO_USUARIO=gestor.socio
SOCIO_SENHA=COLOQUE_AQUI

# /gestor-jogos/mcp
MCP_TOKEN_JOGOS=
JOGOS_USUARIO=gestor.jogos
JOGOS_SENHA=COLOQUE_AQUI

# /gestor-loja/mcp
MCP_TOKEN_LOJA=
LOJA_USUARIO=gestor.loja
LOJA_SENHA=COLOQUE_AQUI

# Plano B: só se o cadastro do conector não aceitar o cabeçalho Authorization.
# Com true, o endereço vira https://mcp-flamengo.democc.online/<rota>/<token>/mcp
MCP_TOKEN_NA_URL=false
