# MCP Loja Flamengo, persona gestor de jogos: ingressos vendidos (item 10) pela Integration API (OData).
# NAO fica em resources/impex de proposito: rodar no HAC (ImpEx Import) depois do deploy do item 10.
#  - FlamengoIngresso: leitura dos ingressos (jogo, poltrona, quem vai usar, comprador, valores, situacao)
#  - FlamengoIngressoEvento: historico e acoes. Um MatchdayTicketEvent novo com type TROCA_POLTRONA,
#    TROCA_TITULAR, CANCELAMENTO, UTILIZACAO ou OBSERVACAO vira a acao (MatchdayTicketEventInterceptor),
#    com as mesmas regras do Backoffice. Chave do evento: ticket + date.
#  - jogosapigroup (gestor.jogos) le os ingressos e cria eventos; nao cria nem altera ingresso direto.

INSERT_UPDATE IntegrationObject; code[unique = true]; integrationType(code)
; FlamengoIngresso ; INBOUND
; FlamengoIngressoEvento ; INBOUND

