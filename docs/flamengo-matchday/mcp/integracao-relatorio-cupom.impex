# MCP "Loja Flamengo" (08/11): relatório por e-mail e cupom pessoal, para os três gestores (loja, jogos, sócio).
# Rodar à mão no HAC (base64 + ImportConfig, por causa do $START_USERRIGHTS), depois do ant all + Update que cria
# os tipos FlaReportMail e FlaCouponGrant (PR do 08/11).
#  - FlamengoRelatorioEmail: o gestor cria um FlaReportMail; o Commerce confere os destinatários
#    (flamengo.mcp.relatorio.destinatarios) e envia o e-mail (FlaReportMailInterceptor)
#  - FlamengoCupomCliente: o gestor cria um FlaCouponGrant; o Commerce confere área, escopo e teto, cria o cupom de uso
#    único e a promoção só para o cliente, publica e envia o código por e-mail (FlaCouponGrantInterceptor)
#  - canal de entrada BASIC para os dois (sem ele a OData responde 403)
#  - permissões por tipo nos três grupos de API, só "+" (negação vence a permissão do papel no Backoffice)
# A área de quem pede vem dos grupos de API do usuário: quem está no jogosapigroup só cria cupom de ingresso,
# estacionamento e alimentação; no socioapigroup, de plano e produtos da loja; no lojaapigroup, da loja.

INSERT_UPDATE IntegrationObject; code[unique = true]; integrationType(code)
; FlamengoRelatorioEmail ; INBOUND
; FlamengoCupomCliente ; INBOUND

