# MCP "Loja Flamengo", persona Gestor da loja (07/11): acesso do gestor.loja pela Integration API (OData).
# Rodar à mão no HAC (base64 + ImportConfig, por causa do $START_USERRIGHTS), depois de integracao-gestores.impex.
#  - 6 objetos de integração novos: produtos (leitura), preços, estoque, experiências, resgates e promoções (leitura)
#  - reaproveita FlamengoPedido, FlamengoCupom e FlamengoCupomUso (já existem, de integracao-gestores.impex)
#  - canal de entrada BASIC para cada objeto novo (sem ele a OData responde 403)
#  - grupo lojaapigroup com permissão por tipo (o lojamanagerrole é BackofficeRole e só vale no Backoffice) e o
#    gestor.loja dentro dele. Os grupos de integração não leem catálogos, então a lista de produtos do Backoffice
#    do gestor continua só com o Flamengo.
# Preço e estoque não têm versão de catálogo: a linha de preço (productId + moeda) e o estoque (código + depósito)
# valem para o Staged e o Online ao mesmo tempo. Promoções ficam só para leitura: ativar ou desativar uma regra
# exige republicar o motor de regras, o que a OData não faz.

INSERT_UPDATE IntegrationObject; code[unique = true]; integrationType(code)
; FlamengoProduto ; INBOUND
; FlamengoPreco ; INBOUND
; FlamengoEstoque ; INBOUND
; FlamengoExperiencia ; INBOUND
; FlamengoResgate ; INBOUND
; FlamengoPromocao ; INBOUND

