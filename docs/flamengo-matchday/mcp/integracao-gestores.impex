INSERT_UPDATE UserGroup; uid[unique = true]; name; groups(uid)
; socioapigroup ; Gestor do sócio-torcedor - API (MCP) ; integrationviewgroup,integrationcreategroup
; jogosapigroup ; Gestor de jogos - API (MCP) ; integrationviewgroup,integrationcreategroup

UPDATE Employee; uid[unique = true]; groups(uid)[mode = append]
; gestor.socio ; socioapigroup
; gestor.jogos ; jogosapigroup

# Só '+' (conceder) ou vazio: nunca '-' (negar). A negação no grupo de API vence a permissão do papel do
# Backoffice e deixava o gestor sem editar (ex.: produtos do gestor.loja). Vazio = sem regra; fora do Backoffice o
# papel não vale, então a API continua sem acesso ao que não está com '+'.
$START_USERRIGHTS
Type;UID;MemberOfGroups;Password;Target;read;change;create;remove;change_perm
