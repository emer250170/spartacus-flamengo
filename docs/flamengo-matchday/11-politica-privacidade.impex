INSERT_UPDATE ContentPage;$online[unique=true];uid[unique=true];name;masterTemplate(uid,$online);label;defaultPage[default='true'];approvalStatus(code)[default='approved'];homepage[default='false'];title[lang=pt];title[lang=en]
;;privacyPolicy;Política de Privacidade;ContentPage1Template;/politica-de-privacidade;;;;Política de Privacidade;Privacy Policy

INSERT_UPDATE CMSParagraphComponent;$online[unique=true];uid[unique=true];name;&componentRef;content[lang=pt];content[lang=en]
;;privacyPolicyMenuParagraph;Política de Privacidade - menu;privacyPolicyMenuParagraph;$menuPt;$menuEn
;;privacyPolicyTextParagraph;Política de Privacidade - texto;privacyPolicyTextParagraph;$textPt;$textEn

INSERT_UPDATE ContentSlot;$online[unique=true];uid[unique=true];name;active;cmsComponents(&componentRef)
;;Section2ASlot-PrivacyPolicy;Section2A Slot for Privacy Policy;true;privacyPolicyMenuParagraph
;;Section2BSlot-PrivacyPolicy;Section2B Slot for Privacy Policy;true;privacyPolicyTextParagraph

INSERT_UPDATE ContentSlotForPage;$online[unique=true];uid[unique=true];position[unique=true];page(uid,$online)[unique=true][default='privacyPolicy'];contentSlot(uid,$online)[unique=true]
