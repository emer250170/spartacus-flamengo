##
## ---------- blocos de texto -------------------------------------------------------------------------
#macro(flaEtiqueta $texto)
<tr><td class="miolo" style="padding:36px 40px 0 40px;font-family:${fonte};font-size:12px;line-height:16px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:${vermelho};">$texto</td></tr>
#end
#macro(flaTitulo $texto)
<tr><td class="miolo titulo" style="padding:10px 40px 0 40px;font-family:${fonte};font-size:28px;line-height:34px;font-weight:bold;color:${preto};">$texto</td></tr>
#end
#macro(flaParagrafo $texto)
<tr><td class="miolo" style="padding:16px 40px 0 40px;font-family:${fonte};font-size:15px;line-height:23px;color:${corTexto};">$texto</td></tr>
#end
## botão: a borda grossa faz o "padding" no Outlook
#macro(flaBotao $rotulo $link)
<tr><td class="miolo" style="padding:26px 40px 8px 40px;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
    <td align="center" bgcolor="${vermelho}" style="background:${vermelho};">
      <a href="$link" style="display:inline-block;border-top:14px solid ${vermelho};border-bottom:14px solid ${vermelho};border-left:30px solid ${vermelho};border-right:30px solid ${vermelho};background:${vermelho};font-family:${fonte};font-size:14px;line-height:16px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#ffffff;text-decoration:none;">$rotulo</a>
    </td>
  </tr></table>
</td></tr>
#end
## caixa cinza com borda vermelha à esquerda: rótulo, título e texto (título ou texto podem ser "")
#macro(flaCaixa $rotulo $titulo $corpo)
<tr><td class="miolo" style="padding:28px 40px 0 40px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    <td width="4" bgcolor="${vermelho}" style="width:4px;background:${vermelho};font-size:0;line-height:0;">&nbsp;</td>
    <td bgcolor="#f6f6f6" style="background:#f6f6f6;padding:16px 18px;font-family:${fonte};">
      <span style="font-size:11px;line-height:16px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:${cinza};">$rotulo</span>
#if($titulo != "")
      <br/><span style="font-size:16px;line-height:24px;font-weight:bold;color:${preto};">$titulo</span>
#end
#if($corpo != "")
      <br/><span style="font-size:13px;line-height:19px;color:${corTexto};">$corpo</span>
#end
    </td>
  </tr></table>
</td></tr>
#end
## valor em destaque (total, reembolso): rótulo à esquerda, valor grande à direita
#macro(flaValor $rotulo $valor)
<tr><td class="miolo" style="padding:20px 40px 0 40px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    <td style="padding:14px 0 0 0;border-top:2px solid ${preto};font-family:${fonte};font-size:17px;line-height:22px;font-weight:bold;color:${preto};">$rotulo</td>
    <td align="right" style="padding:14px 0 0 0;border-top:2px solid ${preto};font-family:${fonte};font-size:22px;line-height:26px;font-weight:bold;color:${preto};">$valor</td>
  </tr></table>
</td></tr>
#end
#macro(flaEspaco)
<tr><td style="padding:0 0 36px 0;font-size:0;line-height:0;">&nbsp;</td></tr>
#end
##
## ---------- moldura -----------------------------------------------------------------------------------
#macro(flaTopo $titulo $resumo)
<!DOCTYPE html>
<html lang="pt-BR" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="x-apple-disable-message-reformatting" />
<title>$titulo</title>
<!--[if mso]><style>table,td,a,span{font-family:Arial,Helvetica,sans-serif !important;}</style><![endif]-->
<style>
  @media only screen and (max-width:620px) {
    .moldura { padding:0 !important; }
    .miolo { padding-left:20px !important; padding-right:20px !important; }
    .titulo { font-size:24px !important; line-height:30px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#efefef;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">$resumo</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#efefef" style="background:#efefef;">
<tr><td align="center" class="moldura" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:600px;background:#ffffff;">
  <tr><td align="center" bgcolor="#ffffff" style="padding:22px 24px 18px 24px;">
    <a href="${loja}/" style="text-decoration:none;"><img src="${logo}" width="63" height="80" alt="FLAMENGO" style="display:block;border:0;outline:none;width:63px;height:80px;font-family:${fonte};font-size:18px;font-weight:bold;color:${vermelho};" /></a>
  </td></tr>
  <tr><td height="8" bgcolor="${vermelho}" style="height:8px;line-height:8px;font-size:0;mso-line-height-rule:exactly;">&nbsp;</td></tr>
  <tr><td height="8" bgcolor="${preto}" style="height:8px;line-height:8px;font-size:0;mso-line-height-rule:exactly;">&nbsp;</td></tr>
#end
#macro(flaRodape $motivo)
  <tr><td height="4" bgcolor="${vermelho}" style="height:4px;line-height:4px;font-size:0;mso-line-height-rule:exactly;">&nbsp;</td></tr>
  <tr><td class="miolo" align="center" bgcolor="${preto}" style="padding:26px 40px 8px 40px;font-family:${fonte};font-size:13px;line-height:20px;font-weight:bold;color:#ffffff;">
    <a href="${loja}/my-account/orders" style="color:#ffffff;text-decoration:none;">Meus pedidos</a>
    &nbsp;&nbsp;<span style="color:${vermelho};">|</span>&nbsp;&nbsp;
    <a href="${loja}/" style="color:#ffffff;text-decoration:none;">Loja Flamengo</a>
    &nbsp;&nbsp;<span style="color:${vermelho};">|</span>&nbsp;&nbsp;
    <a href="${loja}/contact" style="color:#ffffff;text-decoration:none;">Fale conosco</a>
  </td></tr>
  <tr><td class="miolo" align="center" bgcolor="${preto}" style="padding:6px 40px 26px 40px;font-family:${fonte};font-size:11px;line-height:17px;color:#9a9a9a;">
    $motivo<br/>Ambiente de demonstração.
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
#end
