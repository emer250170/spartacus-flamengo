#macro(flaLinhaItem $e $titulo $detalhe $qtd $valor)
<tr>
  <td width="64" valign="top" style="padding:14px 0;border-bottom:1px solid ${linha};">#flaImagem($e.product)</td>
  <td valign="top" style="padding:14px 12px 14px 14px;border-bottom:1px solid ${linha};font-family:${fonte};font-size:15px;line-height:20px;font-weight:bold;color:${preto};">
    $titulo
#if($detalhe != "")
    <br/><span style="font-size:13px;line-height:18px;font-weight:normal;color:${corTexto};">$detalhe</span>
#end
    <br/><span style="font-size:12px;line-height:18px;font-weight:normal;color:${cinza};">Qtd. ${qtd}</span>
  </td>
  <td valign="top" align="right" style="padding:14px 0;border-bottom:1px solid ${linha};font-family:${fonte};font-size:15px;line-height:20px;font-weight:bold;color:${preto};white-space:nowrap;">$valor</td>
</tr>
#end
#macro(flaTituloBloco $texto)
<tr><td colspan="3" style="padding:28px 0 6px 0;border-bottom:2px solid ${preto};font-family:${fonte};font-size:12px;line-height:16px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:${vermelho};">$texto</td></tr>
#end
