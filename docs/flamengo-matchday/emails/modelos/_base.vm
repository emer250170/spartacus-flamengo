## ===================================================================================================
## Base comum dos e-mails da Loja Flamengo (gerar.py junta este arquivo com o de cada e-mail).
## HTML de e-mail no padrão que o Outlook (motor do Word) entende: só tabelas; espaçamento sempre em <td>
## (o Outlook ignora padding/margin em <div> e em <a>); botão com borda grossa da mesma cor; toda imagem
## com texto alternativo. As imagens vão embutidas na mensagem pelo FlaEmailService (PR #222).
## Endereços fixos: a loja é o Spartacus e as fotos vêm das /medias da API (o baseUrl do site aponta
## para localhost). Os macros têm o prefixo "fla" e são idênticos em todos os e-mails (o Velocity guarda
## macro com o mesmo nome entre um e-mail e outro).
## ===================================================================================================
#set($loja = "https://spartacus-flamengo.democc.online/electronics-spa/pt/BRL")
#set($midia = "https://api-flamengo.democc.online")
#set($logo = "https://spartacus-flamengo.democc.online/assets/email/escudo-flamengo.png")
#set($vermelho = "#d70000")
#set($preto = "#1b1b1b")
#set($cinza = "#6b6b6b")
#set($corTexto = "#444444")
#set($linha = "#e6e6e6")
#set($fonte = "Arial, Helvetica, sans-serif")
##
## ---------- itens -----------------------------------------------------------------------------------
## miniatura do produto; sem foto, um quadrado cinza com "+"
#macro(flaImagem $produto)
#set($img = "")
#if($produto && $produto.images)
#foreach($i in $produto.images)
#if($img == "" && ($i.format == "thumbnail" || $i.format == "product"))
#set($img = $i.url)
#end
#end
#end
#if($img != "")
#if($img.startsWith("http"))#set($src = $img)#else#set($src = "${midia}${img}")#end
<img src="$src" width="64" height="64" alt="" style="display:block;border:0;outline:none;width:64px;height:64px;background:#f2f2f2;" />
#else
<table role="presentation" width="64" cellpadding="0" cellspacing="0" border="0"><tr><td width="64" height="64" align="center" valign="middle" bgcolor="#f2f2f2" style="background:#f2f2f2;width:64px;height:64px;font-family:${fonte};font-size:22px;font-weight:bold;color:${vermelho};">+</td></tr></table>
#end
#end
