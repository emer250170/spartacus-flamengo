# =====================================================================
#  Entrega no Brasil para a loja electronics (site electronics-spa)
#  - zona "brasil" e o Brasil nos países de entrega da loja
#  - modo "Ingresso digital e retirada no estádio" (R$ 0) para o matchday
#  - frete padrão e premium em BRL
#  Depois de importar, limpar o cache da API (countriesCache) ou esperar
#  a expiração, senão o Brasil demora a aparecer no checkout.
# =====================================================================
INSERT_UPDATE Zone;code[unique=true];countries(isocode)
;brasil;BR

INSERT_UPDATE ZoneDeliveryMode;code[unique=true];net;active[default=true];name[lang=pt];name[lang=en];description[lang=pt];description[lang=en]
;matchday-digital;false;;Ingresso digital e retirada no estádio;Digital ticket and stadium pickup;Ingresso no app, comida na poltrona e camisa retirada no estádio;Ticket in the app, food at your seat, jersey picked up at the stadium

INSERT_UPDATE ZoneDeliveryModeValue;deliveryMode(code)[unique=true];zone(code)[unique=true];currency(isocode)[unique=true];value;minimum[unique=true]
;matchday-digital;brasil;BRL;0;0
;standard-gross;brasil;BRL;19.90;0
;premium-gross;brasil;BRL;39.90;0
;standard-net;brasil;BRL;19.90;0
;premium-net;brasil;BRL;39.90;0

UPDATE BaseStore;uid[unique=true];deliveryCountries(isocode)[mode=append];deliveryModes(code)[mode=append]
;electronics;BR;matchday-digital
