# =====================================================================
#  Matchday Flamengo - produtos de jogos (ingressos por setor)
#  Importar em: HAC > Console > ImpEx Import (depois rodar 02 e 03 e o
#  full-electronicsIndex-cronJob)
#  Modelo: cada jogo = produto base; cada setor = variante (GenericVariantProduct)
#  Dados de demonstração, iguais aos do protótipo.
# =====================================================================

# ---- Loja demo: site electronics-spa / Electronics Store (BRL, pt) ---
$productCatalog=flamengoProductCatalog
$warehouse=warehouse_s
$currency=BRL
$lang=pt
# ---------------------------------------------------------------------

$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$supercategories=supercategories(code,$catalogVersion)
$baseProduct=baseProduct(code,$catalogVersion)
$approved=approvalstatus(code)[default='approved']

# ---------------------------------------------------------------------
# 1. Categorias de navegação
# ---------------------------------------------------------------------
INSERT_UPDATE Category;code[unique=true];$catalogVersion;name[lang=$lang];$supercategories;allowedPrincipals(uid)[default='customergroup']
;flamengo_ingressos;;Ingressos;
;flamengo_jogos_casa;;Jogos em casa;flamengo_ingressos

# ---------------------------------------------------------------------
# 2. Dimensão de variante "Setor" e seus valores
# ---------------------------------------------------------------------
INSERT_UPDATE VariantCategory;code[unique=true];$catalogVersion;name[lang=$lang];hasImage;allowedPrincipals(uid)[default='customergroup']
;setor;;Setor;false

INSERT_UPDATE VariantValueCategory;code[unique=true];$catalogVersion;name[lang=$lang];$supercategories;sequence;allowedPrincipals(uid)[default='customergroup']
;setor-norte;;Norte;setor;1
;setor-sul;;Sul;setor;2
;setor-leste-inf;;Leste Inferior;setor;3
;setor-oeste-sup;;Oeste Superior;setor;4

# ---------------------------------------------------------------------
# 3. Produtos base - um por jogo
#    (supercategories inclui a VariantCategory "setor")
# ---------------------------------------------------------------------
INSERT_UPDATE Product;code[unique=true];$catalogVersion;name[lang=$lang];summary[lang=$lang];description[lang=$lang];$supercategories;variantType(code);unit(code)[default=pieces];$approved
;FLA-PAL-20261019;;Flamengo x Palmeiras · 19 OUT · 20h00;Brasileirão · Rodada 31 · Maracanã;Segunda, 19 de outubro, 20h00, no Maracanã. Escolha o setor e monte o seu dia de jogo: estacionamento, comidas e bebidas e a camisa nova no mesmo pedido.;flamengo_jogos_casa,setor;GenericVariantProduct
;FLA-RAC-20261022;;Flamengo x Racing · 22 OUT · 21h30;Copa · Semifinal · Maracanã;Quinta, 22 de outubro, 21h30, no Maracanã. Escolha o setor e monte o seu dia de jogo.;flamengo_jogos_casa,setor;GenericVariantProduct
;FLA-FLU-20261101;;Flamengo x Fluminense · 1 NOV · 16h00;Brasileirão · Rodada 33 · Maracanã;Domingo, 1º de novembro, 16h00, no Maracanã. Pré-venda para sócios. Escolha o setor e monte o seu dia de jogo.;flamengo_jogos_casa,setor;GenericVariantProduct

# ---------------------------------------------------------------------
# 4. Variantes - jogo x setor
# ---------------------------------------------------------------------
INSERT_UPDATE GenericVariantProduct;code[unique=true];$catalogVersion;$baseProduct;name[lang=$lang];$supercategories;unit(code)[default=pieces];$approved
;FLA-PAL-20261019-NORTE;;FLA-PAL-20261019;Flamengo x Palmeiras · Setor Norte;setor-norte
;FLA-PAL-20261019-SUL;;FLA-PAL-20261019;Flamengo x Palmeiras · Setor Sul;setor-sul
;FLA-PAL-20261019-LESTE;;FLA-PAL-20261019;Flamengo x Palmeiras · Leste Inferior;setor-leste-inf
;FLA-PAL-20261019-OESTE;;FLA-PAL-20261019;Flamengo x Palmeiras · Oeste Superior;setor-oeste-sup
;FLA-RAC-20261022-NORTE;;FLA-RAC-20261022;Flamengo x Racing · Setor Norte;setor-norte
;FLA-RAC-20261022-SUL;;FLA-RAC-20261022;Flamengo x Racing · Setor Sul;setor-sul
;FLA-RAC-20261022-LESTE;;FLA-RAC-20261022;Flamengo x Racing · Leste Inferior;setor-leste-inf
;FLA-RAC-20261022-OESTE;;FLA-RAC-20261022;Flamengo x Racing · Oeste Superior;setor-oeste-sup
;FLA-FLU-20261101-NORTE;;FLA-FLU-20261101;Flamengo x Fluminense · Setor Norte;setor-norte
;FLA-FLU-20261101-SUL;;FLA-FLU-20261101;Flamengo x Fluminense · Setor Sul;setor-sul
;FLA-FLU-20261101-LESTE;;FLA-FLU-20261101;Flamengo x Fluminense · Leste Inferior;setor-leste-inf
;FLA-FLU-20261101-OESTE;;FLA-FLU-20261101;Flamengo x Fluminense · Oeste Superior;setor-oeste-sup

# =====================================================================
# Mesmos itens na versao Online (o catalogo Flamengo nao tem job de sync)
# =====================================================================
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Online'])[unique=true,default=$productCatalog:Online]
$supercategories=supercategories(code,$catalogVersion)
$baseProduct=baseProduct(code,$catalogVersion)

# ---------------------------------------------------------------------
# 1. Categorias de navegação
# ---------------------------------------------------------------------
INSERT_UPDATE Category;code[unique=true];$catalogVersion;name[lang=$lang];$supercategories;allowedPrincipals(uid)[default='customergroup']
;flamengo_ingressos;;Ingressos;
;flamengo_jogos_casa;;Jogos em casa;flamengo_ingressos

# ---------------------------------------------------------------------
# 2. Dimensão de variante "Setor" e seus valores
# ---------------------------------------------------------------------
INSERT_UPDATE VariantCategory;code[unique=true];$catalogVersion;name[lang=$lang];hasImage;allowedPrincipals(uid)[default='customergroup']
;setor;;Setor;false

INSERT_UPDATE VariantValueCategory;code[unique=true];$catalogVersion;name[lang=$lang];$supercategories;sequence;allowedPrincipals(uid)[default='customergroup']
;setor-norte;;Norte;setor;1
;setor-sul;;Sul;setor;2
;setor-leste-inf;;Leste Inferior;setor;3
;setor-oeste-sup;;Oeste Superior;setor;4

# ---------------------------------------------------------------------
# 3. Produtos base - um por jogo
#    (supercategories inclui a VariantCategory "setor")
# ---------------------------------------------------------------------
INSERT_UPDATE Product;code[unique=true];$catalogVersion;name[lang=$lang];summary[lang=$lang];description[lang=$lang];$supercategories;variantType(code);unit(code)[default=pieces];$approved
;FLA-PAL-20261019;;Flamengo x Palmeiras · 19 OUT · 20h00;Brasileirão · Rodada 31 · Maracanã;Segunda, 19 de outubro, 20h00, no Maracanã. Escolha o setor e monte o seu dia de jogo: estacionamento, comidas e bebidas e a camisa nova no mesmo pedido.;flamengo_jogos_casa,setor;GenericVariantProduct
;FLA-RAC-20261022;;Flamengo x Racing · 22 OUT · 21h30;Copa · Semifinal · Maracanã;Quinta, 22 de outubro, 21h30, no Maracanã. Escolha o setor e monte o seu dia de jogo.;flamengo_jogos_casa,setor;GenericVariantProduct
;FLA-FLU-20261101;;Flamengo x Fluminense · 1 NOV · 16h00;Brasileirão · Rodada 33 · Maracanã;Domingo, 1º de novembro, 16h00, no Maracanã. Pré-venda para sócios. Escolha o setor e monte o seu dia de jogo.;flamengo_jogos_casa,setor;GenericVariantProduct

# ---------------------------------------------------------------------
# 4. Variantes - jogo x setor
# ---------------------------------------------------------------------
INSERT_UPDATE GenericVariantProduct;code[unique=true];$catalogVersion;$baseProduct;name[lang=$lang];$supercategories;unit(code)[default=pieces];$approved
