#### ---------- template (somente Staged, nao aprovado) ----------
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$supercategories=supercategories(code,$catalogVersion)
$baseProduct=baseProduct(code,$catalogVersion)

INSERT_UPDATE Product;code[unique=true];$catalogVersion;name[lang=pt];summary[lang=pt];description[lang=pt];$supercategories;variantType(code);unit(code)[default=pieces];approvalstatus(code)
;FLA-TEMPLATE-MARACANA;;Template de jogo · Maracanã (não vender);Template · Maracanã;Template com o mapa de setores e poltronas do Maracanã e o preço base de cada setor. Usado pelo script abrir-jogo para criar cada partida.;setor,poltrona;GenericVariantProduct;;check

