# =====================================================================
#  Template de jogo no Maracana (poltrona como produto)
#  - dimensoes de variante: Setor > Poltrona (a poltrona e a variante final)
#  - produto FLA-TEMPLATE-MARACANA com 4 setores x 8 fileiras x 12 poltronas
#    = 384 poltronas, preco por setor; fica SO na versao Staged e nao
#    aprovado: nunca aparece na loja. O script abrir-jogo.groovy copia o
#    template para cada jogo novo, direto na versao Online.
#  Escala real: o mesmo modelo serve para ~78 mil lugares (ver README).
# =====================================================================
$productCatalog=flamengoProductCatalog
$currency=BRL


#### ---------- dimensoes de variante (Staged) ----------
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$supercategories=supercategories(code,$catalogVersion)

INSERT_UPDATE VariantCategory;code[unique=true];$catalogVersion;name[lang=pt];name[lang=en];$supercategories;hasImage;allowedPrincipals(uid)[default='customergroup']
;setor;;Setor;Sector;;false
;poltrona;;Poltrona;Seat;setor;false

