# =====================================================================
#  Matchday Flamengo - estacionamento, comidas e bebidas, Camisa Jogo 2
#  + ajustes nos jogos (nome em ingles, preco "a partir de", estoque no card)
#  Catalogo: flamengoProductCatalog (Staged e Online), loja electronics-spa
# =====================================================================
$productCatalog=flamengoProductCatalog
$warehouse=warehouse_s
$currency=BRL

#### ---------- bloco repetido para Staged e Online ----------
$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$supercategories=supercategories(code,$catalogVersion)
$baseProduct=baseProduct(code,$catalogVersion)
$approved=approvalstatus(code)[default='approved']

INSERT_UPDATE Category;code[unique=true];$catalogVersion;name[lang=pt];name[lang=en];$supercategories;allowedPrincipals(uid)[default='customergroup']
;flamengo_ingressos;;Ingressos;Tickets;
;flamengo_jogos_casa;;Jogos em casa;Home matches;flamengo_ingressos
;flamengo_matchday;;Dia de jogo;Matchday;flamengo_ingressos
;flamengo_md_estacionamento;;Estacionamento;Parking;flamengo_matchday
;flamengo_md_comidas;;Comidas e bebidas;Food and drinks;flamengo_matchday

INSERT_UPDATE VariantCategory;code[unique=true];$catalogVersion;name[lang=pt];name[lang=en];hasImage;allowedPrincipals(uid)[default='customergroup']
;setor;;Setor;Sector;false
;tamanho-camisa;;Tamanho;Size;false

