# =====================================================================
#  Mengo Estúdio (07/11; PR estudio-base): Drop 01 · História, linhas, estampas e camisetas.
#  Importar depois do ant all + Update (tipos MengoDrop, MengoLinha, MengoEstampa e atributos novos).
#  Datas: 18 dias depois das do protótipo de referência (o Drop 01 fica no ar em novembro/dezembro);
#  o relógio do painel da demo desloca o "agora" sem mexer nestes dados.
#  Artes: carregadas à parte (scripts/estudio-artes.groovy, gerado por scripts/estudio-artes.py);
#  as estampas sem arte mostram a ilustração da loja até alguém enviar a arte pelo Backoffice.
# =====================================================================
$productCatalog=flamengoProductCatalog
$warehouse=warehouse_s
$currency=BRL

INSERT_UPDATE MengoLinha;code[unique=true];name[lang=pt];name[lang=en];description[lang=pt];description[lang=en];position
;historia;História;History;Títulos, ídolos e os momentos que a Nação viveu.;Titles, idols and the moments the Nation lived.;1
;urubu;Urubu;Vulture;O símbolo da torcida em todas as versões: mascote, selo, padrão e traço.;The fans' symbol in every version: mascot, seal, pattern and line.;2
;jogadores;Jogadores;Players;Elenco atual e os gringos do Mengão em pôsteres e selos.;Current squad and Mengão's foreign players in posters and stamps.;3

INSERT_UPDATE MengoDrop;code[unique=true];number;name[lang=pt];name[lang=en];description[lang=pt];description[lang=en];active
;HIS;1;História;History;Um drop, três linhas: História, Urubu e Jogadores. Cada estampa fica à venda até a sua data.;One drop, three lines: History, Vulture and Players. Each print is on sale until its date.;true

